{%- comment -%}
  Parameters:
  - product {Object} - Product object.
  - product_url {String} - Product URL.

  Usage:
  {% render 'card-compare-toggle', product: product, product_url: product_url %}
{%- endcomment -%}
<div class="card__compare-inline">
  <input type="checkbox" class="checkbox--compare visually-hidden js-compare-checkbox" id="compare-{{ product.id }}"
         data-product-id="{{ product.id }}" data-product-url="{{ product_url }}">
  <label for="compare-{{ product.id }}" class="card__compare-inline-btn" aria-label="{{ 'products.compare.switch_label' | t | escape }}" title="{{ 'products.compare.switch_label' | t | escape }}">
    <span class="visually-hidden">{{ 'products.compare.switch_label' | t }}</span>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" role="presentation" class="icon">
      <path fill="currentColor" d="M10 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h5v2h2V1h-2v2zm0 15H5V5h5v13zm9-15h-5v2h5v13h-5v2h5c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
    </svg>
  </label>
</div>
