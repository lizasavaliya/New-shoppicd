{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'product.css' | asset_url }}" media="print" onload="this.media='all'">
{%- else -%}
  {{ 'product.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if settings.enable_quick_add -%}
  <link rel="stylesheet" href="{{ 'quick-add.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'variant-picker.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'custom-select.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign color_scheme_dark = section.settings.color_scheme_dark
  assign bg_color = false

  if color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg_grad | default: settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg_grad | default: settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg_grad | default: settings.color_scheme_3_bg
  endif

  if bg_color == settings.bg_color or bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif

  assign desktop_align = section.settings.heading_align_desktop | default: 'text-start'
  assign mobile_align = section.settings.heading_align_mobile | default: 'text-start'
  assign heading_tag = section.settings.heading_tag | default: 'h2'

  assign heading_size_class = 'h4'
  case section.settings.heading_size
    when 'small'
      assign heading_size_class = 'h5'
    when 'large'
      assign heading_size_class = 'h3'
    when 'xl'
      assign heading_size_class = 'h2'
  endcase

  assign desktop_columns = section.settings.desktop_columns | plus: 0
  assign desktop_rows = section.settings.desktop_rows | plus: 0
  assign mobile_columns = section.settings.mobile_columns | plus: 0
  assign products_limit = desktop_columns
  if section.settings.enable_carousel_desktop
    assign products_limit = desktop_columns | times: 2
  else
    assign products_limit = desktop_columns | times: desktop_rows
  endif
  assign products_limit = products_limit | at_least: mobile_columns

  assign rendered_heading = section.settings.heading | replace: '[', '<span class="cc-text-highlight">' | replace: ']', '</span>'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .pc-section {
    --pc-desktop-columns: {{ section.settings.desktop_columns }};
    --pc-desktop-gap: {{ section.settings.desktop_gap }}px;
    --pc-mobile-gap: {{ section.settings.mobile_gap }}px;
    --pc-promo-width: 280px;
    --pc-promo-mobile-height: 200px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .pc-shell {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .pc-inner {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .pc-section-header {
    gap: 1.6rem;
    margin-bottom: 2rem;
  }

  #shopify-section-{{ section.id }} .pc-section-header .section__heading {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .pc-view-all--below {
    margin-top: 2rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pc-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-bottom: 1.8rem;
  }

  #shopify-section-{{ section.id }} .pc-tab {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.8rem;
    padding: 0.7rem 1.2rem;
    border: 1px solid rgba(var(--text-color)/0.12);
    border-radius: 1.4rem;
    background: rgba(var(--bg-color)/0.85);
    color: inherit;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pc-tab:hover,
  #shopify-section-{{ section.id }} .pc-tab[aria-selected='true'] {
    border-color: rgba(var(--text-color)/0.32);
    background: rgba(var(--text-color)/0.06);
  }

  #shopify-section-{{ section.id }} .pc-tab[aria-selected='true'] {
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .pc-tab__thumb {
    width: 2.8rem;
    height: 2.8rem;
    min-width: 2.8rem;
    max-width: 2.8rem;
    border-radius: 0.9rem;
    overflow: hidden;
    background: rgba(var(--text-color)/0.06);
    flex: 0 0 2.8rem;
    position: relative;
  }

  #shopify-section-{{ section.id }} .pc-tab__thumb .media,
  #shopify-section-{{ section.id }} .pc-tab__thumb img,
  #shopify-section-{{ section.id }} .pc-tab__thumb svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .pc-tab__thumb-icon {
    width: 1.6rem;
    height: 1.6rem;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.4;
  }

  #shopify-section-{{ section.id }} .pc-tab__label {
    margin: 0;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .pc-panel {
    display: none;
  }

  #shopify-section-{{ section.id }} .pc-panel.is-active {
    display: block;
  }

  #shopify-section-{{ section.id }} .pc-panel__grid {
    display: grid;
    gap: var(--pc-desktop-gap);
    align-items: start;
  }

  #shopify-section-{{ section.id }} .pc-panel__grid.has-promo {
    grid-template-columns: minmax(0, var(--pc-promo-width)) minmax(0, 1fr);
  }

  #shopify-section-{{ section.id }} .pc-panel__grid.has-promo.pc-promo-right {
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--pc-promo-width));
  }

  #shopify-section-{{ section.id }} .pc-panel__grid.has-promo.pc-promo-right .pc-promo {
    order: 2;
  }

  #shopify-section-{{ section.id }} .pc-panel__grid.has-promo.pc-promo-right .pc-products {
    order: 1;
  }

  #shopify-section-{{ section.id }} .pc-promo {
    min-width: 0;
    align-self: stretch;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .pc-promo--sticky {
    position: sticky;
    top: 2rem;
  }

  #shopify-section-{{ section.id }} .pc-promo-card {
    position: relative;
    height: 100%;
    min-height: 200px;
    border-radius: 1.6rem;
    overflow: hidden;
    background: rgba(var(--text-color)/0.05);
  }

  #shopify-section-{{ section.id }} .pc-promo-card.color-scheme {
    background-color: rgba(var(--bg-color));
  }

  #shopify-section-{{ section.id }} .pc-promo-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--pc-overlay-opacity, 0));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .pc-promo-media {
    position: relative;
    height: 100%;
    min-height: 100%;
  }

  #shopify-section-{{ section.id }} .pc-promo-media .media,
  #shopify-section-{{ section.id }} .pc-promo-media img,
  #shopify-section-{{ section.id }} .pc-promo-media video,
  #shopify-section-{{ section.id }} .pc-promo-media iframe,
  #shopify-section-{{ section.id }} .pc-promo-media .media__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .pc-promo-media iframe {
    border: 0;
  }

  #shopify-section-{{ section.id }} .pc-promo-content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    padding: 2rem;
  }

  #shopify-section-{{ section.id }} .pc-promo-content.pc-align-left {
    justify-content: flex-start;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .pc-promo-content.pc-align-center {
    justify-content: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pc-promo-content.pc-align-right {
    justify-content: flex-end;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .pc-promo-content.pc-pos-top {
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .pc-promo-content.pc-pos-center {
    align-items: center;
  }

  #shopify-section-{{ section.id }} .pc-promo-content.pc-pos-bottom {
    align-items: flex-end;
  }

  #shopify-section-{{ section.id }} .pc-promo-copy {
    position: relative;
    z-index: 2;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .pc-promo-copy > *:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .pc-promo-text.text-highlight--underline .cc-text-highlight,
  #shopify-section-{{ section.id }} .pc-heading.text-highlight--underline .cc-text-highlight {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .pc-promo-text.text-highlight--bold .cc-text-highlight,
  #shopify-section-{{ section.id }} .pc-heading.text-highlight--bold .cc-text-highlight {
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .pc-promo-text.text-highlight--italic .cc-text-highlight,
  #shopify-section-{{ section.id }} .pc-heading.text-highlight--italic .cc-text-highlight {
    font-style: italic;
  }

  #shopify-section-{{ section.id }} .pc-promo-text.text-highlight--highlight .cc-text-highlight,
  #shopify-section-{{ section.id }} .pc-heading.text-highlight--highlight .cc-text-highlight {
    background: currentColor;
    color: inherit;
    padding: 0 0.14em;
    mix-blend-mode: multiply;
  }

  #shopify-section-{{ section.id }} .text-transform--uppercase {
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .text-transform--lowercase {
    text-transform: lowercase;
  }

  #shopify-section-{{ section.id }} .text-transform--capitalize {
    text-transform: capitalize;
  }

  #shopify-section-{{ section.id }} .pc-products {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .pc-products__viewport {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .pc-products__track {
    display: grid;
    gap: var(--pc-desktop-gap);
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
  }

  #shopify-section-{{ section.id }} .pc-products__track.is-carousel-desktop {
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--pc-desktop-gap) * {{ section.settings.desktop_columns | minus: 1 }})) / {{ section.settings.desktop_columns }});
    grid-template-columns: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #shopify-section-{{ section.id }} .pc-products__track.is-carousel-desktop::-webkit-scrollbar,
  #shopify-section-{{ section.id }} .pc-products__track.is-carousel-mobile::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .pc-products__track.is-carousel-mobile {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #shopify-section-{{ section.id }} .pc-products__item {
    min-width: 0;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .pc-card--hide-vendor .card__vendor,
  #shopify-section-{{ section.id }} .pc-card--hide-rating .rating,
  #shopify-section-{{ section.id }} .pc-card--hide-rating .rating__count,
  #shopify-section-{{ section.id }} .pc-card--hide-labels .product-label-container {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .pc-product-controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
  }

  #shopify-section-{{ section.id }} .pc-arrow {
    width: 4rem;
    height: 4rem;
    padding: 0;
    border-radius: 999px;
    border: 1px solid rgba(var(--text-color)/0.15);
    background: rgba(var(--bg-color)/0.92);
  }

  #shopify-section-{{ section.id }} .pc-arrow svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  #shopify-section-{{ section.id }} .pc-arrow[disabled] {
    opacity: 0.45;
    cursor: default;
  }

  #shopify-section-{{ section.id }} .pc-section--divider {
    border-top: 1px solid rgba(var(--text-color)/0.12);
  }

  #shopify-section-{{ section.id }} .pc-tab-title--bold {
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .pc-tab-title--uppercase {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  #shopify-section-{{ section.id }} .pc-tab-title--italic {
    font-style: italic;
  }

  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .pc-tab-title--small {
      font-size: 1.3rem;
    }

    #shopify-section-{{ section.id }} .pc-tab-title--medium {
      font-size: 1.5rem;
    }

    #shopify-section-{{ section.id }} .pc-tab-title--large {
      font-size: 1.7rem;
    }

    {% for block in section.blocks %}
      #shopify-section-{{ section.id }} .pc-panel-{{ block.id }} {
        --pc-promo-width: {{ block.settings.desktop_promotion_width }}px;
      }

      {% if block.settings.desktop_promotion_ratio == 'square' %}
        #shopify-section-{{ section.id }} .pc-panel-{{ block.id }} .pc-promo-card {
          aspect-ratio: 1 / 1;
        }
      {% elsif block.settings.desktop_promotion_ratio == 'portrait' %}
        #shopify-section-{{ section.id }} .pc-panel-{{ block.id }} .pc-promo-card {
          aspect-ratio: 4 / 5;
        }
      {% elsif block.settings.desktop_promotion_ratio == 'landscape' %}
        #shopify-section-{{ section.id }} .pc-panel-{{ block.id }} .pc-promo-card {
          aspect-ratio: 5 / 4;
        }
      {% endif %}
    {% endfor %}
  }

  @media (max-width: 768.98px) {
    #shopify-section-{{ section.id }} .pc-section {
      text-align: {% if mobile_align == 'text-center' %}center{% elsif mobile_align == 'text-end' %}right{% else %}left{% endif %};
    }

    #shopify-section-{{ section.id }} .pc-section-header {
      align-items: {% if mobile_align == 'text-center' %}center{% elsif mobile_align == 'text-end' %}flex-end{% else %}flex-start{% endif %} !important;
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .pc-tabs {
      gap: 0.8rem;
    }

    #shopify-section-{{ section.id }} .pc-tab {
      padding: 0.6rem 1rem;
      min-height: 4.4rem;
      border-radius: 1.2rem;
    }

    #shopify-section-{{ section.id }} .pc-tab__thumb {
      width: 2.6rem;
      height: 2.6rem;
    }

    #shopify-section-{{ section.id }} .pc-panel__grid,
    #shopify-section-{{ section.id }} .pc-panel__grid.has-promo,
    #shopify-section-{{ section.id }} .pc-panel__grid.has-promo.pc-promo-right {
      grid-template-columns: 1fr;
      gap: var(--pc-mobile-gap);
    }

    #shopify-section-{{ section.id }} .pc-promo,
    #shopify-section-{{ section.id }} .pc-products {
      order: initial !important;
    }

    #shopify-section-{{ section.id }} .pc-promo--sticky {
      position: static;
    }

    #shopify-section-{{ section.id }} .pc-promo-card {
      min-height: var(--pc-promo-mobile-height);
    }

    {% for block in section.blocks %}
      #shopify-section-{{ section.id }} .pc-panel-{{ block.id }} {
        --pc-promo-mobile-height: {{ block.settings.mobile_promotion_height }}px;
      }
    {% endfor %}

    #shopify-section-{{ section.id }} .pc-products__track {
      gap: var(--pc-mobile-gap);
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, minmax(0, 1fr));
    }

    {% if section.settings.enable_swipe_mobile %}
      #shopify-section-{{ section.id }} .pc-products__track {
        grid-auto-flow: column;
        grid-auto-columns: calc((100% - (var(--pc-mobile-gap) * {{ section.settings.mobile_columns | minus: 1 }})) / {{ section.settings.mobile_columns }});
        grid-template-columns: none;
      }
    {% endif %}

    #shopify-section-{{ section.id }} .pc-product-controls {
      display: none;
    }
  }
{%- endstyle -%}

{%- capture section_classes -%}
pc-section section{% if bg_color %} section--padded{% if section.settings.section_width == 'full' %} section--full-width{% endif %}{% endif %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}{% unless color_scheme_dark == 'none' %} cc-dark:color-scheme cc-dark:color-scheme--{{ color_scheme_dark }}{% endunless %}{% if section.settings.show_section_divider %} pc-section--divider{% endif %}
{%- endcapture -%}

{%- if section.settings.section_width == 'page' -%}
  <div class="container pc-shell">
{%- endif -%}

<div class="{{ section_classes | strip }}" {% if settings.animations_enabled != "disabled" %}data-cc-animate{% endif %}>
  <div class="{% if section.settings.section_width == 'full' %}container{% endif %} pc-inner">
    {%- if section.settings.subheading != blank or section.settings.heading != blank or section.settings.view_all_label != blank and section.settings.view_all_position == 'above' -%}
      <div class="pc-section-header section__header items-center flex{% if desktop_align == 'text-center' %} flex-col text-center{% elsif desktop_align == 'text-end' %} flex-row-reverse flex-wrap{% else %} flex-row flex-wrap{% endif %} gap-x-theme">
        <div class="flex-auto">
          {%- if section.settings.subheading != blank -%}
            <p class="subheading mb-1">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <{{ heading_tag }} class="section__heading {{ heading_size_class }} pc-heading text-highlight--{{ section.settings.highlight_effect }}{% if section.settings.text_transform != 'none' %} text-transform--{{ section.settings.text_transform }}{% endif %} {{ desktop_align }}">
              {{ rendered_heading }}
            </{{ heading_tag }}>
          {%- endif -%}
        </div>

        {%- if section.settings.view_all_label != blank and section.settings.view_all_position == 'above' -%}
          <a
            href="{% if section.blocks.first.settings.link != blank %}{{ section.blocks.first.settings.link }}{% elsif section.blocks.first.settings.collection != blank %}{{ section.blocks.first.settings.collection.url }}{% else %}#{% endif %}"
            class="{% if section.settings.view_all_style == 'btn-primary' %}btn btn--primary{% elsif section.settings.view_all_style == 'btn-secondary' %}btn btn--secondary{% else %}link{% endif %}"
            data-pc-view-all
          >
            {{- section.settings.view_all_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pc-tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Promotional collections' | escape }}">
        {%- for block in section.blocks -%}
          {%- assign block_collection = block.settings.collection -%}
          {%- assign tab_title = block_collection.title | default: 'Collection' -%}
          <button
            type="button"
            class="pc-tab"
            role="tab"
            id="pc-tab-{{ block.id }}"
            aria-controls="pc-panel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-pc-tab="{{ block.id }}"
            data-pc-url="{% if block.settings.link != blank %}{{ block.settings.link }}{% elsif block_collection != blank %}{{ block_collection.url }}{% else %}#{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if section.settings.show_collection_image -%}
              <span class="pc-tab__thumb">
                {%- if block_collection != blank and block_collection.featured_image != blank -%}
                  <span class="media relative">
                    {% render 'image', image: block_collection.featured_image, widths: '64, 96', src_width: 64, class: 'img-fit' %}
                  </span>
                {%- else -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="pc-tab__thumb-icon">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21,15 16,10 5,21"/>
                  </svg>
                {%- endif -%}
              </span>
            {%- endif -%}
            <span class="pc-tab__label pc-tab-title--{{ section.settings.tab_title_size }} pc-tab-title--{{ section.settings.tab_title_style }}">
              {{- tab_title | escape -}}
            </span>
          </button>
        {%- endfor -%}
      </div>

      <div class="pc-panels">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_collection = block.settings.collection
            assign promo_product = block.settings.product
            assign promo_heading = block.settings.heading | replace: '[', '<span class="cc-text-highlight">' | replace: ']', '</span>'
            assign promo_text = block.settings.text | replace: '[', '<span class="cc-text-highlight">' | replace: ']', '</span>'
            assign promo_color_scheme = block.settings.color_scheme
            assign promo_color_scheme_dark = block.settings.color_scheme_dark
            assign promo_link = block.settings.link
            if promo_link == blank and block_collection != blank
              assign promo_link = block_collection.url
            endif
            assign card_classes = ''
            unless block.settings.show_vendor
              assign card_classes = card_classes | append: ' pc-card--hide-vendor'
            endunless
            unless block.settings.show_product_rating
              assign card_classes = card_classes | append: ' pc-card--hide-rating'
            endunless
            unless block.settings.show_labels_badges
              assign card_classes = card_classes | append: ' pc-card--hide-labels'
            endunless
          -%}
          <div
            id="pc-panel-{{ block.id }}"
            class="pc-panel pc-panel-{{ block.id }}{% if forloop.first %} is-active{% endif %}"
            role="tabpanel"
            aria-labelledby="pc-tab-{{ block.id }}"
            data-pc-panel="{{ block.id }}"
          >
            <div class="pc-panel__grid{% if block.settings.enable_promotion %} has-promo pc-promo-{{ block.settings.desktop_promotion_position }}{% endif %}">
              {%- if block.settings.enable_promotion -%}
                <div class="pc-promo{% if block.settings.enable_sticky_promotion_desktop %} pc-promo--sticky{% endif %}">
                  {%- if promo_product != blank -%}
                    <div class="{{ card_classes | strip }}">
                      {%- render 'product-card',
                        product: promo_product,
                        collection: block_collection,
                        card_size: 'medium',
                        card_contain: section.settings.show_product_card_background,
                        disable_quickbuy: block.settings.show_quick_view_button == false
                      -%}
                    </div>
                  {%- else -%}
                    <div
                      class="pc-promo-card{% unless promo_color_scheme == 'none' %} color-scheme color-scheme--{{ promo_color_scheme }}{% endunless %}{% unless promo_color_scheme_dark == 'none' %} cc-dark:color-scheme cc-dark:color-scheme--{{ promo_color_scheme_dark }}{% endunless %}"
                      style="--pc-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
                    >
                      {%- if promo_link != blank -%}
                        <a
                          href="{{ promo_link }}"
                          class="pc-promo-media block"
                          {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                        >
                      {%- else -%}
                        <div class="pc-promo-media">
                      {%- endif -%}
                        {%- if block.settings.video != blank -%}
                          {{ block.settings.video | video_tag: class: 'img-fit', autoplay: block.settings.enable_video_autoplay, loop: true, muted: true, controls: block.settings.show_sound_control, playsinline: true }}
                        {%- elsif block.settings.video_url != blank -%}
                          <iframe
                            src="{{ block.settings.video_url }}"
                            allow="autoplay; encrypted-media; picture-in-picture"
                            allowfullscreen
                            loading="lazy"
                            {% if block.settings.video_alt_text != blank %}title="{{ block.settings.video_alt_text | escape }}"{% endif %}
                          ></iframe>
                        {%- elsif block.settings.image != blank or block.settings.mobile_image != blank -%}
                          {%- if block.settings.mobile_image != blank -%}
                            {%- render 'image-desktop-and-mobile',
                              class: 'img-fit',
                              desktop_image: block.settings.image,
                              mobile_image: block.settings.mobile_image,
                              src_width_mobile: 700,
                              widths_mobile: '400, 700, 900',
                              src_width_desktop: 900,
                              widths_desktop: '600, 900, 1200',
                              lazy_load: true,
                              fetchpriority: 'auto',
                              sizes: '100vw',
                              block: block
                            -%}
                          {%- else -%}
                            {% render 'image',
                              image: block.settings.image,
                              widths: '600, 900, 1200',
                              src_width: 900,
                              class: 'img-fit'
                            %}
                          {%- endif -%}
                        {%- elsif block_collection != blank and block_collection.featured_image != blank -%}
                          {% render 'image',
                            image: block_collection.featured_image,
                            widths: '600, 900, 1200',
                            src_width: 900,
                            class: 'img-fit'
                          %}
                        {%- else -%}
                          {{ 'collection-1' | placeholder_svg_tag: 'media__placeholder img-fit' }}
                        {%- endif -%}
                      {%- if promo_link != blank -%}
                        </a>
                      {%- else -%}
                        </div>
                      {%- endif -%}

                      {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
                        <div class="pc-promo-content pc-align-{{ block.settings.overlay_content_alignment }} pc-pos-{{ block.settings.overlay_content_position }}">
                          <div class="pc-promo-copy">
                            {%- if block.settings.heading != blank -%}
                              <h3 class="{{ block.settings.promo_heading_size }}">
                                {{ promo_heading }}
                              </h3>
                            {%- endif -%}

                            {%- if block.settings.text != blank -%}
                              <div class="rte pc-promo-text {{ block.settings.text_size }} text-highlight--{{ block.settings.highlight_effect }}{% if block.settings.text_transform != 'none' %} text-transform--{{ block.settings.text_transform }}{% endif %}">
                                {{ promo_text }}
                              </div>
                            {%- endif -%}

                            {%- if block.settings.button_label != blank -%}
                              <div class="mt-4">
                                <a
                                  class="{% if block.settings.button_style == 'btn-primary' %}btn btn--primary{% elsif block.settings.button_style == 'btn-secondary' %}btn btn--secondary{% else %}link{% endif %}"
                                  {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% elsif promo_link != blank %}href="{{ promo_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                                  {% if block.settings.button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                                >
                                  {{- block.settings.button_label | escape -}}
                                </a>
                              </div>
                            {%- endif -%}
                          </div>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="pc-products">
                {%- if section.settings.show_navigation_arrows and section.settings.enable_carousel_desktop -%}
                  <div class="pc-product-controls">
                    <button type="button" class="pc-arrow btn" data-pc-prev aria-label="{{ 'general.slider.previous' | t }}">
                      {% render 'icon-chevron-left' %}
                    </button>
                    <button type="button" class="pc-arrow btn" data-pc-next aria-label="{{ 'general.slider.next' | t }}">
                      {% render 'icon-chevron-right' %}
                    </button>
                  </div>
                {%- endif -%}

                <div class="pc-products__viewport">
                  <div
                    class="pc-products__track{% if section.settings.enable_carousel_desktop %} is-carousel-desktop{% endif %}{% if section.settings.enable_swipe_mobile %} is-carousel-mobile{% endif %}"
                    data-pc-track
                    {% if section.settings.autoplay_every > 0 %}data-pc-autoplay="{{ section.settings.autoplay_every | times: 1000 }}"{% endif %}
                  >
                    {%- if block_collection != blank and block_collection.products_count > 0 -%}
                      {%- for product in block_collection.products limit: products_limit -%}
                        <div class="pc-products__item {{ card_classes | strip }}">
                          {%- render 'product-card',
                            product: product,
                            collection: block_collection,
                            card_size: 'medium',
                            card_contain: section.settings.show_product_card_background,
                            disable_quickbuy: block.settings.show_quick_view_button == false
                          -%}
                        </div>
                      {%- endfor -%}
                    {%- else -%}
                      {%- for i in (1..products_limit) -%}
                        <div class="pc-products__item">
                          {%- render 'product-card', product: '', card_size: 'medium', card_contain: section.settings.show_product_card_background -%}
                        </div>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.view_all_label != blank and section.settings.view_all_position == 'below' -%}
      <div class="pc-view-all--below">
        <a
          href="{% if section.blocks.first.settings.link != blank %}{{ section.blocks.first.settings.link }}{% elsif section.blocks.first.settings.collection != blank %}{{ section.blocks.first.settings.collection.url }}{% else %}#{% endif %}"
          class="{% if section.settings.view_all_style == 'btn-primary' %}btn btn--primary{% elsif section.settings.view_all_style == 'btn-secondary' %}btn btn--secondary{% else %}link{% endif %}"
          data-pc-view-all
        >
          {{- section.settings.view_all_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.section_width == 'page' -%}
  </div>
{%- endif -%}

<script>
  (function() {
    function initPromotionalCollections(sectionId) {
      var section = document.getElementById('shopify-section-' + sectionId);
      if (!section || section.dataset.pcReady === 'true') return;
      section.dataset.pcReady = 'true';

      var tabs = Array.prototype.slice.call(section.querySelectorAll('[data-pc-tab]'));
      var panels = Array.prototype.slice.call(section.querySelectorAll('[data-pc-panel]'));
      var viewAllLinks = Array.prototype.slice.call(section.querySelectorAll('[data-pc-view-all]'));

      function activate(tabId) {
        tabs.forEach(function(tab) {
          var active = tab.getAttribute('data-pc-tab') === tabId;
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        panels.forEach(function(panel) {
          panel.classList.toggle('is-active', panel.getAttribute('data-pc-panel') === tabId);
        });

        var activeTab = section.querySelector('[data-pc-tab="' + tabId + '"]');
        if (activeTab) {
          var url = activeTab.getAttribute('data-pc-url') || '#';
          viewAllLinks.forEach(function(link) {
            link.setAttribute('href', url);
          });
        }
      }

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          activate(this.getAttribute('data-pc-tab'));
        });
      });

      var tracks = Array.prototype.slice.call(section.querySelectorAll('[data-pc-track]'));
      tracks.forEach(function(track) {
        var wrapper = track.closest('.pc-products');
        if (!wrapper) return;

        var prevBtn = wrapper.querySelector('[data-pc-prev]');
        var nextBtn = wrapper.querySelector('[data-pc-next]');

        function updateButtons() {
          if (!prevBtn || !nextBtn) return;
          prevBtn.disabled = track.scrollLeft <= 2;
          nextBtn.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
        }

        function pageScroll(direction) {
          track.scrollBy({
            left: direction * Math.max(track.clientWidth * 0.92, 240),
            behavior: 'smooth'
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', function() {
            pageScroll(-1);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function() {
            pageScroll(1);
          });
        }

        track.addEventListener('scroll', updateButtons, { passive: true });
        window.addEventListener('resize', updateButtons);
        updateButtons();

        var autoplayMs = parseInt(track.getAttribute('data-pc-autoplay') || '0', 10);
        if (autoplayMs > 0) {
          window.setInterval(function() {
            var activePanel = track.closest('.pc-panel');
            if (activePanel && !activePanel.classList.contains('is-active')) return;

            var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
            if (atEnd) {
              track.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
              pageScroll(1);
            }
          }, autoplayMs);
        }
      });
    }

    initPromotionalCollections('{{ section.id }}');
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        initPromotionalCollections('{{ section.id }}');
      }
    });
  })();
</script>

