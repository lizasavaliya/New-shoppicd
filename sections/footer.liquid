            },
            {
              "value": "Inter",
              "label": "Inter"
            },
            {
              "value": "Montserrat",
              "label": "Montserrat"
            }
          ],
          "default": "Bebas Neue"
        },
        {
          "type": "range",
          "id": "text_spacing",
          "label": "Text spacing",
          "min": 0,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "image_picker",
          "id": "image_light",
          "label": "Image (light)"
        },
        {
          "type": "image_picker",
          "id": "image_dark",
          "label": "Image (dark)"
        },
        {
          "type": "range",
          "id": "desktop_logo_width",
          "label": "Desktop logo width",
          "min": 50,
          "max": 150,
          "step": 1,
          "unit": "%",
          "default": 100
        },
        {
          "type": "range",
          "id": "mobile_logo_width",
          "label": "Mobile logo width",
          "min": 50,
          "max": 150,
          "step": 1,
          "unit": "%",
          "default": 100
        },
        {
          "type": "range",
          "id": "top_padding",
          "label": "Top padding",
          "min": 0,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 32
        },
        {
          "type": "range",
          "id": "bottom_padding",
