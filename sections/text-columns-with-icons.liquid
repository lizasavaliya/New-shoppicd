{%- if section.blocks.size > 0 -%}

  {%- liquid
    assign color_scheme = section.settings.color_scheme
    assign color_scheme_dark = section.settings.color_scheme_dark
    assign desktop_columns = section.settings.desktop_columns
    assign mobile_columns = section.settings.mobile_columns | plus: 0
    assign block_gap = section.settings.block_spacing
    assign mobile_gap = section.settings.mobile_block_spacing
    assign icon_pos = section.settings.icon_position
    assign enable_carousel = section.settings.enable_carousel_desktop
    assign enable_swipe = section.settings.enable_swipe_mobile

    assign rendered_heading = section.settings.heading | replace: '[', '<span class="cc-text-highlight">' | replace: ']', '</span>'

    assign heading_tag = section.settings.heading_tag | default: 'h2'
    assign heading_size_class = 'h4'
    case section.settings.heading_size
      when 'small'
        assign heading_size_class = 'h5'
      when 'medium'
        assign heading_size_class = 'h4'
      when 'large'
        assign heading_size_class = 'h3'
      when 'xl'
        assign heading_size_class = 'h2'
    endcase
  -%}

  {%- style -%}
    #shopify-section-{{ section.id }} .tcwi-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .tcwi-grid {
      display: grid;
      grid-auto-flow: column;
      gap: {{ block_gap }}px;
      grid-auto-columns: calc((100% - ({{ desktop_columns | minus: 1 }} * {{ block_gap }}px)) / {{ desktop_columns }});
    }

    {%- if section.settings.line_and_border == 'vertical' -%}
      #shopify-section-{{ section.id }} .tcwi-item:not(:last-child) {
        box-shadow: 1px 0 0 0 currentColor;
        padding-right: {{ block_gap | divided_by: 2 }}px;
      }
      @media (max-width: 768.98px) {
        {%- if mobile_columns == 1 -%}
          #shopify-section-{{ section.id }} .tcwi-item,
          #shopify-section-{{ section.id }} .tcwi-item:not(:last-child) {
            box-shadow: none;
            padding-right: 0;
          }
        {%- else -%}
          #shopify-section-{{ section.id }} .tcwi-item,
          #shopify-section-{{ section.id }} .tcwi-item:not(:last-child) {
            box-shadow: none;
            padding-right: 0;
          }
          #shopify-section-{{ section.id }} .tcwi-item:nth-child({{ mobile_columns }}n+1) {
            box-shadow: 1px 0 0 0 currentColor;
            padding-right: {{ mobile_gap | divided_by: 2 }}px;
          }
        {%- endif -%}
      }
    {%- elsif section.settings.line_and_border == 'horizontal' -%}
      #shopify-section-{{ section.id }} .tcwi-item:not(:last-child) {
        border-bottom: 1px solid currentColor;
        padding-bottom: {{ block_gap | divided_by: 2 }}px;
      }
    {%- endif -%}

    {%- unless section.settings.column_bg_light == blank or section.settings.column_bg_light == 'rgba(0,0,0,0)' -%}
      #shopify-section-{{ section.id }} .tcwi-item {
        background-color: {{ section.settings.column_bg_light }};
        padding: {{ block_gap | divided_by: 2 }}px;
      }
    {%- endunless -%}

    {%- unless section.settings.icon_color_light == blank or section.settings.icon_color_light == 'rgba(0,0,0,0)' -%}
      #shopify-section-{{ section.id }} .tcwi-icon {
        color: {{ section.settings.icon_color_light }};
      }
    {%- endunless -%}

    {%- unless section.settings.column_bg_dark == blank or section.settings.column_bg_dark == 'rgba(0,0,0,0)' -%}
      .cc-dark #shopify-section-{{ section.id }} .tcwi-item {
        background-color: {{ section.settings.column_bg_dark }};
      }
    {%- endunless -%}

    {%- unless section.settings.icon_color_dark == blank or section.settings.icon_color_dark == 'rgba(0,0,0,0)' -%}
      .cc-dark #shopify-section-{{ section.id }} .tcwi-icon {
        color: {{ section.settings.icon_color_dark }};
      }
    {%- endunless -%}

    @media (max-width: 768.98px) {
      #shopify-section-{{ section.id }} .slider {
        overflow: visible;
      }
      #shopify-section-{{ section.id }} .tcwi-grid {
        grid-auto-flow: row;
        grid-template-columns: repeat({{ mobile_columns }}, minmax(0, 1fr));
        grid-auto-columns: auto;
        gap: {{ mobile_gap }}px;
      }
      #shopify-section-{{ section.id }} .tcwi-heading {
        font-size: 0.85em;
      }
      #shopify-section-{{ section.id }} .tcwi-text .rte {
        font-size: 0.8em;
      }
    }

    {%- if enable_swipe -%}
      @media (max-width: 768.98px) {
        #shopify-section-{{ section.id }} .slider {
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
        }
        #shopify-section-{{ section.id }} .tcwi-grid {
          grid-auto-flow: column;
          grid-template-columns: none;
          grid-auto-columns: calc((100% - ({{ mobile_columns | minus: 1 }} * {{ mobile_gap }}px)) / {{ mobile_columns }});
        }
      }
    {%- endif -%}
  {%- endstyle -%}

  {%- if section.settings.section_width == 'page' -%}
    <div class="container">
  {%- endif -%}

  <div
    class="tcwi-section section{% if section.settings.section_width == 'full' %} section--full-width{% endif %} section--padded-{{ section.settings.section_height }}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}{% unless color_scheme_dark == 'none' %} cc-dark:color-scheme cc-dark:color-scheme--{{ color_scheme_dark }}{% endunless %}{% if section.settings.show_section_divider %} border-top{% endif %}"
    id="{{ section.id }}"
  >
    <div class="{% if section.settings.section_width == 'full' %}container{% endif %}">

      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }}
          class="section__heading {{ heading_size_class }} text-highlight--{{ section.settings.highlight_effect }}{% if section.settings.text_transform != 'none' %} text-transform--{{ section.settings.text_transform }}{% endif %} {{ section.settings.content_alignment }}"
          {% if settings.animations_enabled != "disabled" and section.settings.prevent_animation == false %}data-cc-animate{% endif %}
        >{{ rendered_heading }}</{{ heading_tag }}>
      {%- endif -%}

      <carousel-slider
        class="carousel block relative"
        inactive
        {% unless enable_swipe %}disable-mobile="true"{% endunless %}
        {% if section.settings.autoplay > 0 %}autoplay="{{ section.settings.autoplay }}"{% endif %}
      >
        {%- if section.settings.show_arrows -%}
          <div class="slider-nav slide-nav--inline flex justify-between absolute top-0 h-full no-js-hidden">
            <button type="button" class="slider-nav__btn tap-target tap-target--left btn text-current has-ltr-icon" name="prev" aria-controls="slider-{{ section.id }}">
              <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
              {% render 'icon-chevron-left' %}
            </button>
            <button type="button" class="slider-nav__btn tap-target tap-target--right btn text-current has-ltr-icon" name="next" aria-controls="slider-{{ section.id }}">
              <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
              {% render 'icon-chevron-right' %}
            </button>
          </div>
        {%- endif -%}

        <div class="slider slider--contained relative{% unless enable_carousel %} slider--no-scrollbar{% endunless %}" id="slider-{{ section.id }}">
          <ul class="tcwi-grid{% if section.settings.line_and_border == 'vertical' %} tcwi-grid--vlines{% endif %}">
            {%- for block in section.blocks -%}
              {%- liquid
                assign block_rendered_text = block.settings.text | replace: '[', '<span class="cc-text-highlight">' | replace: ']', '</span>'
                assign block_heading_class = 'h5'
                case block.settings.heading_size
                  when 'small'
                    assign block_heading_class = 'h6'
                  when 'medium'
                    assign block_heading_class = 'h5'
                  when 'large'
                    assign block_heading_class = 'h4'
                endcase
              -%}
              <li
                class="tcwi-item flex{% if icon_pos == 'above' %} flex-col items-center {{ section.settings.content_alignment }}{% else %} items-start{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_enabled != "disabled" and section.settings.prevent_animation == false %}
                  data-cc-animate
                  data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"
                {% endif %}
              >

                {%- if block.settings.custom_icon != blank -%}
                  {%- liquid
                    assign icon_2x = section.settings.icon_size | times: 2
                    assign icon_widths = section.settings.icon_size | append: ', ' | append: icon_2x
                    assign img_style = 'width: ' | append: section.settings.icon_size | append: 'px; height: auto; flex-shrink: 0;'
                  -%}
                  {{ block.settings.custom_icon | image_url: width: icon_2x | image_tag: widths: icon_widths, loading: 'lazy', style: img_style }}
                {%- elsif block.settings.use_another_icon != blank or block.settings.icon != 'none' -%}
                  <div class="tcwi-icon" style="flex-shrink: 0; width: {{ section.settings.icon_size }}px; height: {{ section.settings.icon_size }}px;">
                    {%- if block.settings.use_another_icon != blank -%}
                      {% render 'icon', icon: block.settings.use_another_icon, width: section.settings.icon_size, height: section.settings.icon_size %}
                    {%- else -%}
                      {% render 'icon', icon: block.settings.icon, width: section.settings.icon_size, height: section.settings.icon_size %}
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- unless block.settings.heading == blank and block.settings.text == blank -%}
                  <div class="tcwi-text{% if icon_pos == 'above' %} mt-3{% else %} ml-4{% endif %}">
                    {%- if block.settings.heading != blank -%}
                      <p class="tcwi-heading {{ block_heading_class }} m-0 text-highlight--{{ block.settings.highlight_effect }}{% if block.settings.text_transform != 'none' %} text-transform--{{ block.settings.text_transform }}{% endif %}">
                        {%- if block.settings.heading_link != blank -%}
                          <a href="{{ block.settings.heading_link }}" class="text-current"{% if block.settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ block.settings.heading | escape }}</a>
                        {%- else -%}
                          {{ block.settings.heading | escape }}
                        {%- endif -%}
                      </p>
                    {%- endif -%}

                    {%- if block.settings.text != blank -%}
                      <div class="rte mt-1">{{ block_rendered_text }}</div>
                    {%- endif -%}
                  </div>
                {%- endunless -%}

              </li>
            {%- endfor -%}
          </ul>
        </div>
      </carousel-slider>

    </div>
  </div>

  {%- if section.settings.section_width == 'page' -%}
    </div>
  {%- endif -%}

{%- endif -%}

{% schema %}
{
  "name": "Text columns with icons",
  "tag": "section",
  "class": "cc-text-columns-with-icons",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap your text between [] to add text highlights. E.g: Adding [marker] will underline [highlight] text."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "highlight_effect",
      "label": "Highlight effect",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "underline", "label": "Underline" },
        { "value": "italic", "label": "Italic" },
        { "value": "bold", "label": "Bold" },
        { "value": "highlight", "label": "Highlight" }
      ],
      "default": "underline"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "line_and_border",
      "label": "Line and border",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "vertical", "label": "Vertical line" },
        { "value": "horizontal", "label": "Horizontal line" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Column content alignment",
      "options": [
        { "value": "text-start", "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-end", "label": "Right" }
      ],
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "value": "above", "label": "Above text" },
        { "value": "beside", "label": "Beside text" }
      ],
      "default": "above"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 36
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel_desktop",
      "label": "Enable carousel on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_mobile",
      "label": "Enable swipe on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Auto-play every",
      "info": "Leave 0 to disable auto-play",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": false
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Number of columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "xsmall", "label": "Extra small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "block_spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Block spacing",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Number of columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_section_height",
      "label": "Section height",
      "options": [
        { "value": "xsmall", "label": "Extra small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "mobile_block_spacing",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Block spacing",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "label": "Show section divider",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme (light)",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "1", "label": "Scheme 1" },
        { "value": "2", "label": "Scheme 2" },
        { "value": "3", "label": "Scheme 3" }
      ],
      "default": "1"
    },
    {
      "type": "color",
      "id": "column_bg_light",
      "label": "Column background (light)"
    },
    {
      "type": "color",
      "id": "icon_color_light",
      "label": "Icon (light)"
    },
    {
      "type": "select",
      "id": "color_scheme_dark",
      "label": "Color scheme (dark)",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "1", "label": "Scheme 1" },
        { "value": "2", "label": "Scheme 2" },
        { "value": "3", "label": "Scheme 3" }
      ],
      "default": "2"
    },
    {
      "type": "color",
      "id": "column_bg_dark",
      "label": "Column background (dark)"
    },
    {
      "type": "color",
      "id": "icon_color_dark",
      "label": "Icon (dark)"
    },
    {
      "type": "header",
      "content": "SEO"
    },
    {
      "type": "checkbox",
      "id": "prevent_animation",
