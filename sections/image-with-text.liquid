{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'image-with-text.css' | asset_url }}" media="print" onload="this.media='all'">
{%- else -%}
  {{ 'image-with-text.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign color_scheme      = section.settings.color_scheme_light
  assign color_scheme_dark = section.settings.color_scheme_dark
  assign layout            = section.settings.layout
  assign section_width     = section.settings.section_width
  assign is_overlay        = false
  if layout == 'overlay'
    assign is_overlay = true
  endif

  if section_width == 'full_width_padded'
    assign outer_class   = 'section--full-width section--padded'
    assign use_container = true
  elsif section_width == 'full_width'
    assign outer_class   = 'section--full-width'
    assign use_container = false
  else
    assign outer_class   = 'container'
    assign use_container = false
  endif
-%}

{%- style -%}
  #{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {%- unless is_overlay -%}
    @media (min-width: 769px) {
      #{{ section.id }} .iwt__media   { flex-basis: {{ section.settings.image_width }}%; }
      #{{ section.id }} .iwt__content { flex-basis: {{ 100 | minus: section.settings.image_width }}%; }
    }
  {%- endunless -%}
  {%- if is_overlay -%}
    #{{ section.id }} .iwt__layout { min-height: {{ section.settings.min_height }}px; }
    #{{ section.id }} .iwt__overlay { opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; }
  {%- endif -%}
{%- endstyle -%}

<div id="{{ section.id }}" class="iwt section {{ outer_class }}
  {%- if color_scheme != 'none' %} color-scheme color-scheme--{{ color_scheme }}{%- endif -%}
  {%- if color_scheme_dark != 'none' %} cc-dark:color-scheme cc-dark:color-scheme--{{ color_scheme_dark }}{%- endif -%}
  {%- if section.settings.show_section_divider %} section--divider{%- endif -%}"
  {%- if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>

  {%- if use_container -%}<div class="container">{%- endif -%}

  {%- if is_overlay -%}

    {%- comment -%} ── OVERLAY LAYOUT ── {%- endcomment -%}
    <div class="iwt__layout iwt__layout--overlay"
      {%- if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>

      {%- comment -%} Background image {%- endcomment -%}
      <div class="iwt__media iwt__media--bg">
        {%- if section.settings.image != blank -%}
          {%- render 'image-desktop-and-mobile',
            desktop_image:     section.settings.image,
            mobile_image:      section.settings.image_mobile,
            class:             'img-fit',
            src_width_desktop: 1920,
            widths_desktop:    '800, 1200, 1600, 1920',
            src_width_mobile:  800,
            widths_mobile:     '400, 600, 800',
            lazy_load:         true
          -%}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder img-fit' }}
        {%- endif -%}
      </div>

      {%- comment -%} Dark overlay {%- endcomment -%}
      <div class="iwt__overlay"></div>

      {%- comment -%} Text content {%- endcomment -%}
      <div class="iwt__content iwt__content--overlay iwt__content--{{ section.settings.content_position }} {{ section.settings.text_align }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'subheading' -%}
              {%- if block.settings.subheading != blank -%}
                <p class="subheading
                  {%- if block.settings.font_size == 'small' %} subheading--small{%- endif -%}
                  {%- if block.settings.font_size == 'large' %} subheading--large{%- endif -%}"
                  {{ block.shopify_attributes }}>
                  {{- block.settings.subheading | escape -}}
                </p>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                {%- assign h_tag = block.settings.heading_tag -%}
                <{{ h_tag }} class="{{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                  {%- render 'multiline-text' with block.settings.heading -%}
                </{{ h_tag }}>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="rte{% if block.settings.enlarge_text %} enlarge-text{% endif %}" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

            {%- when 'button' -%}
              {%- if block.settings.button_label != blank -%}
                <div class="section__block--button" {{ block.shopify_attributes }}>
                  <a class="{{ block.settings.button_style }}"
                    {%- if block.settings.button_link == blank %} role="link" aria-disabled="true"
                    {%- else %} href="{{ block.settings.button_link }}"
                    {%- endif -%}
                    {%- if block.settings.button_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                    {{- block.settings.button_label | escape -}}
                  </a>
                </div>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>

  {%- else -%}

    {%- comment -%} ── SIDE BY SIDE LAYOUT ── {%- endcomment -%}
    <div class="iwt__layout{% if layout == 'image_right' %} iwt__layout--image-right{% endif %}"
      {%- if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>

      {%- comment -%} Media {%- endcomment -%}
      <div class="iwt__media relative overflow-hidden">
        {%- if section.settings.image != blank -%}
          {%- render 'image-desktop-and-mobile',
            desktop_image:     section.settings.image,
            mobile_image:      section.settings.image_mobile,
            class:             'img-fit',
            src_width_desktop: 1400,
            widths_desktop:    '600, 800, 1000, 1200, 1400',
            src_width_mobile:  800,
            widths_mobile:     '400, 600, 800',
            lazy_load:         true
          -%}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'media__placeholder' }}
        {%- endif -%}
      </div>

      {%- comment -%} Content {%- endcomment -%}
      <div class="iwt__content flex flex-col justify-center {{ section.settings.text_align }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'subheading' -%}
              {%- if block.settings.subheading != blank -%}
                <p class="subheading
                  {%- if block.settings.font_size == 'small' %} subheading--small{%- endif -%}
                  {%- if block.settings.font_size == 'large' %} subheading--large{%- endif -%}"
                  {{ block.shopify_attributes }}>
                  {{- block.settings.subheading | escape -}}
                </p>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                {%- assign h_tag = block.settings.heading_tag -%}
                <{{ h_tag }} class="{{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                  {%- render 'multiline-text' with block.settings.heading -%}
                </{{ h_tag }}>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="rte{% if block.settings.enlarge_text %} enlarge-text{% endif %}" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

            {%- when 'button' -%}
              {%- if block.settings.button_label != blank -%}
                <div class="section__block--button" {{ block.shopify_attributes }}>
                  <a class="{{ block.settings.button_style }}"
                    {%- if block.settings.button_link == blank %} role="link" aria-disabled="true"
                    {%- else %} href="{{ block.settings.button_link }}"
                    {%- endif -%}
                    {%- if block.settings.button_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                    {{- block.settings.button_label | escape -}}
                  </a>
                </div>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>

  {%- endif -%}

  {%- if use_container -%}</div>{%- endif -%}

</div>

{% schema %}
{
  "name": "Image with text",
  "class": "cc-image-with-text",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Falls back to desktop image."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "full_width_padded", "label": "Full width padded" },
        { "value": "full_width",        "label": "Full width" },
        { "value": "contained",         "label": "Contained" }
      ],
      "default": "full_width_padded"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "overlay",     "label": "Image overlay text" },
        { "value": "image_left",  "label": "Image left" },
        { "value": "image_right", "label": "Image right" }
      ],
      "default": "overlay"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Image width (side by side only)",
      "default": 50
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "text-start",  "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-end",    "label": "Right" }
      ],
      "default": "text-start"
    },
    {
      "type": "header",
      "content": "Overlay options"
    },
    {
      "type": "paragraph",
      "content": "These settings apply only when Image position is set to \"Image overlay text\"."
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Min height",
      "default": 400
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 20
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom",
      "default": 32
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "label": "Show section divider",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme_light",
      "label": "Color scheme (light)",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "1",    "label": "Scheme 1" },
        { "value": "2",    "label": "Scheme 2" },
        { "value": "3",    "label": "Scheme 3" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "color_scheme_dark",
      "label": "Color scheme (dark)",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "1",    "label": "Scheme 1" },
        { "value": "2",    "label": "Scheme 2" },
        { "value": "3",    "label": "Scheme 3" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Subheading"
        },
        {
          "type": "select",
          "id": "font_size",
          "label": "Font size",
          "options": [
            { "value": "small",  "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large",  "label": "Large" }
          ],
          "default": "medium"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Enter <br> for a line-break.",
          "default": "Image with text"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h2"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h6", "label": "Extra extra small" },
            { "value": "h5", "label": "Extra small" },
            { "value": "h4", "label": "Small" },
            { "value": "h3", "label": "Medium" },
            { "value": "h2", "label": "Large" },
            { "value": "h1", "label": "Extra large" },
            { "value": "h0", "label": "Extra extra large" }
          ],
          "default": "h3"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
        },
        {
          "type": "checkbox",
          "id": "enlarge_text",
          "label": "Enlarge text",
          "default": false
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_new_tab",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "link",               "label": "Link" },
            { "value": "btn btn--primary",   "label": "Primary button" },
            { "value": "btn btn--secondary", "label": "Secondary button" }
          ],
          "default": "btn btn--primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "category": "Image",
      "blocks": [
        { "type": "subheading" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  }
}
{% endschema %}
