{%- comment -%}theme-check-disable NestedSnippet{%- endcomment -%}

{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'media-with-text.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'product.css' | asset_url }}" media="print" onload="this.media='all'">

  {%- if section.settings.product.media.size > 0 -%}
    {{ 'media-gallery.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
{%- else -%}
  {{ 'media-with-text.css' | asset_url | stylesheet_tag }}
  {{ 'product.css' | asset_url | stylesheet_tag }}

  {%- if section.settings.product.media.size > 0 -%}
    {{ 'media-gallery.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
{%- endif -%}

{%- if product.metafields.reviews.rating.value != blank -%}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (document.getElementById('shopify-product-reviews')) {
        const link = document.createElement('link');
        link.rel = "stylesheet";
        link.href = "{{ 'reviews.css' | asset_url }}";
        document.body.appendChild(link);
      }
    }, { once: true });
  </script>
{%- endif -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- for block in section.blocks -%}
  {%- if block.type == 'countdown-timer' -%}
    <script src="{{ 'countdown-timer.js' | asset_url }}" defer="defer"></script>
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- liquid
  assign product = all_products[section.settings.product]
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign first_3d_model = product.media | where: 'media_type', 'model' | first
  assign media_ratio = section.settings.media_ratio

  if media_ratio == 'natural'
    assign media_ratio = 99
    for media in product.media
      if media.preview_image.aspect_ratio < media_ratio
        assign media_ratio = media.preview_image.aspect_ratio
      endif
    endfor
  endif

  assign color_scheme = section.settings.color_scheme
  assign bg_color = false

  if color_scheme == 'default'
    assign bg_color = settings.bg_color
  elsif color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg_grad | default: settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg_grad | default: settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg_grad | default: settings.color_scheme_3_bg
  endif

  if bg_color == settings.bg_color or bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif
-%}

{%- style -%}
  #{{ section.id }} .media-gallery__main .media-xr-button { display: none; }
  #{{ section.id }} .active .media-xr-button:not([data-shopify-xr-hidden]) { display: block; }
{%- endstyle -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .section {
    margin: calc(4 * var(--space-unit)) auto;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .container {
    overflow: visible;
    max-width: calc(var(--page-width, 1320px) + var(--gutter) * 2);
  }

  #{{ section.id }}.product {
    width: 100%;
    max-width: none;
    margin: 0;
    align-items: start;
    gap: 32px;
  }

  #{{ section.id }} .product-media {
    padding: 0;
  }

  #{{ section.id }} .product-media .media,
  #{{ section.id }} .product-media .media-gallery,
  #{{ section.id }} .product-media .media-gallery__main {
    border-radius: 12px;
    overflow: hidden;
    background: #eef1f3;
  }

  #{{ section.id }} .media__placeholder,
  #{{ section.id }} .product-media img {
    background: #eef1f3;
  }

  #{{ section.id }} .product-info {
    padding: 32px;
    border-radius: 14px;
    background: #f7f4e8;
  }

  #{{ section.id }} .product-vendor-sku,
  #{{ section.id }} .product-vendor,
  #{{ section.id }} .product-vendor a {
    color: #8d8d84;
    font-size: 14px;
    line-height: 1.4;
    text-decoration: none;
  }

  #{{ section.id }} .product-title,
  #{{ section.id }} .product-title a {
    color: #222222;
    font-size: clamp(2rem, 2.5vw, 3rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  #{{ section.id }} .product-info__price,
  #{{ section.id }} .price {
    color: #1d1d1b;
  }

  #{{ section.id }} .product-info__block,
  #{{ section.id }} .product-info__block--sm {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  #{{ section.id }} .product-info__block:first-child,
  #{{ section.id }} .product-info__block--sm:first-child { margin-top: 0; }
  #{{ section.id }} .product-info__block:last-child,
  #{{ section.id }} .product-info__block--sm:last-child { margin-bottom: 0; }
  #{{ section.id }} .product-info__countdown {
    display: inline-block;
    padding: 12px 18px;
    border: 1px solid rgba(34, 34, 34, 0.08);
    border-radius: 12px;
    background: #ffffff;
  }
  #{{ section.id }} .product-info__countdown .countdown-label {
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #ea5b0c;
  }
  #{{ section.id }} .countdown-timer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  #{{ section.id }} .countdown-number {
    font-weight: 700;
    font-size: 1.125rem;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    min-width: 3rem;
    text-align: center;
    display: inline-block;
    background: #f5bb1e;
    color: #171717;
  }
  #{{ section.id }} .countdown-sep {
    font-size: 1.125rem;
    font-weight: 700;
    color: #9e9b92;
  }
  #{{ section.id }} .product-info__icon-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  #{{ section.id }} .product-info__icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.55rem;
    min-width: 92px;
    padding: 14px 12px;
    border: 1px solid rgba(34, 34, 34, 0.06);
    border-radius: 12px;
    background: #ffffff;
  }
  #{{ section.id }} .icon-item__badge {
    width: 52px;
    height: 52px;
    border: 1px solid #d8d8d3;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    overflow: hidden;
  }
  #{{ section.id }} .icon-item__label {
    font-size: 0.82rem;
    color: #5d5a52;
    text-align: center;
    margin: 0;
    line-height: 1.35;
  }

  #{{ section.id }} .product-info__add-to-cart {
    align-items: stretch;
    gap: 12px;
  }

  #{{ section.id }} .product-info__add-to-cart quantity-input {
    flex: 0 0 126px;
    margin: 0;
  }

  #{{ section.id }} .product-info__add-button,
  #{{ section.id }} quantity-input + .product-info__add-button {
    flex: 1 1 auto;
    margin: 0;
  }

  #{{ section.id }} quantity-input .qty-input {
    height: 48px;
    border: 1px solid rgba(34, 34, 34, 0.14);
    border-radius: 8px;
    background: #faf8ef;
    overflow: hidden;
  }

  #{{ section.id }} quantity-input .qty-input__btn,
  #{{ section.id }} quantity-input .qty-input__input {
    height: 48px;
    color: #5c5b53;
    background: transparent;
  }

  #{{ section.id }} quantity-input .qty-input__btn {
    font-size: 1.65rem;
  }

  #{{ section.id }} .product-info__add-button .btn {
    min-height: 48px;
    border-radius: 8px;
    background: #04521f;
    background-image: none;
    color: #ffffff;
    font-weight: 700;
    box-shadow: none;
  }

  #{{ section.id }} .product-info__add-button .btn[disabled] {
    opacity: 0.55;
    background: #e8d894;
    color: #9ca0a9;
  }

  #{{ section.id }} .product-info__add-button .btn:hover {
    background: #034118;
  }

  .rating__stars { --no-rating-col: rgb(61 60 59 / 16%);}

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .section {
      margin: calc(3 * var(--space-unit)) auto;
    }

    #{{ section.id }}.product {
      gap: 20px;
    }

    #{{ section.id }} .product-info {
      padding: 22px 18px;
      border-radius: 12px;
    }

    #{{ section.id }} .product-title,
    #{{ section.id }} .product-title a {
      font-size: 2rem;
    }

    #{{ section.id }} .product-info__icon-item {
      min-width: calc(50% - 0.45rem);
    }

    #{{ section.id }} .product-info__add-to-cart {
      gap: 10px;
    }

    #{{ section.id }} .product-info__add-to-cart quantity-input {
      flex: 0 0 112px;
    }
  }
{%- endstyle -%}

{%- if first_3d_model -%}
  <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'model-viewer.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'product-model.js' | asset_url }}" defer></script>
{%- endif -%}

<div class="section{% if bg_color %} section--padded section--full-width{% endif %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
  <div class="container overflow-hidden">
    <div id="{{ section.id }}" class="product media-with-text js-product" data-section="{{ section.id }}" style="--media-width: {{ section.settings.media_width }}%">
      <div class="product-media mb-4 md:mb-0 product-media--slider media-with-text__media">
        {%- if product != blank -%}
          {%- if product.featured_media -%}
            {% render 'media-gallery',
              product: product,
              current_variant: current_variant,
              media_ratio: media_ratio,
              media_crop: section.settings.media_crop,
              first_3d_model: first_3d_model,
              enable_zoom: section.settings.enable_zoom,
              zoom_mode: section.settings.zoom_mode,
              enable_lightbox_mobile: false,
              zoom_level: section.settings.hover_zoom,
              featured_product: true
            %}
          {%- else -%}
            <div class="media relative">
              {{ 'image' | placeholder_svg_tag: 'media__placeholder' }}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="media relative">
            {%- capture placeholder_svg_name -%}product-{{ 'now' | date: '%N' | modulo: 6 | plus: 1 }}{%- endcapture -%}
            {{ placeholder_svg_name | placeholder_svg_tag: 'media__placeholder' }}
          </div>
        {%- endif -%}
      </div>

      <div class="product-info media-with-text__text w-full">
        <script type="application/json" class="js-inventory-data" data-dynamic-variant-content="{{ section.id }}-inventory-data">
          {
            {%- if current_variant -%}
              "inventory_quantity":{{- current_variant.inventory_quantity | at_least: 0 | json -}},"available":{{- current_variant.available | json -}},"inventory_policy":{{- current_variant.inventory_policy | json -}},"inventory_management":{{- current_variant.inventory_management | json -}}
            {%- endif -%}
          }
        </script>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                {% render block %}
              </div>

            {%- when 'vendor-sku' -%}
              {%- if block.settings.show_vendor or block.settings.show_sku or block.settings.show_barcode -%}
                <div class="product-info__block product-info__block--sm product-vendor-sku text-sm" data-dynamic-variant-content="{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.show_vendor and product.vendor != blank -%}
                    {%- liquid
                      assign vendor_handle = product.vendor | handle
                      if collections[vendor_handle].handle == vendor_handle
                        assign vendor_url = collections[vendor_handle].url
                      else
                        assign vendor_url = product.vendor | url_for_vendor
                      endif
                    -%}
                    <span class="product-vendor">
                      {{ product.vendor | link_to: vendor_url }}
                    </span>
                  {%- elsif block.settings.show_vendor and product == blank -%}
                    <span class="product-vendor">
                      {{ 'onboarding.product.vendor' | t }}
                    </span>
                  {%- endif -%}

                  {%- if block.settings.show_sku -%}
                    <span class="product-sku"{% if current_variant.sku == blank %} hidden{% endif %}>
                      {%- if block.settings.show_vendor and product.vendor != blank %} &nbsp;|&nbsp; {% endif -%}
                      <span>{{ 'products.product.sku' | t }}</span>
                      {% if product != blank -%}
                        <span class="product-sku__value">{{ current_variant.sku }}</span>
                      {%- else -%}
                        {{ 'onboarding.product.sku' | t }}
                      {% endif -%}
                    </span>
                  {%- endif -%}

                  {%- if block.settings.show_barcode -%}
                    <span class="product-info__barcode"{% if current_variant.barcode == blank %} hidden{% endif %}>
                      {%- if block.settings.show_vendor or block.settings.show_sku %} &nbsp;|&nbsp; {% endif -%}
                      <span>{{ 'products.product.barcode' | t }}</span>
                      <span class="product-info__barcode-value">{% if current_variant.barcode %}{{ current_variant.barcode }}{% endif %}</span>
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'type' -%}
              <div class="product-info__block product-info__block--sm text-sm" data-dynamic-product-content="{{ section.id }}-{{ block.id }}"{% if product.type == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
                {%- liquid
                  if product.type != blank
                    assign product_type_handle = product.type | handle
                    if collections[product_type_handle].handle == product_type_handle
                      assign type_url = collections[product_type_handle].url
                    else
                      assign type_url = product.type | url_for_type
                    endif
                    echo product.type | link_to: type_url
                  endif
                -%}
              </div>

            {%- when 'title' -%}
              <div class="product-info__block product-info__block--sm product-info__title" data-dynamic-variant-content="{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                <h2 class="product-title h4">
                  {%- if product.title != blank -%}
                    <a href="{{ product.url }}" class="text-current">{{ product.title | escape }}</a>
                  {%- else -%}
                    {{ 'onboarding.product.title' | t }}
                  {%- endif -%}

                  {% if block.settings.show_weight %}
                    <span class="product-info__weight text-body-extra_small"{% unless current_variant.weight > 0 %} hidden{% endunless %}>
                      {% if current_variant.weight > 0 %}
                        {{ current_variant.weight | weight_with_unit: current_variant.weight_unit }}
                      {% endif %}
                    </span>
                  {% endif %}
                </h2>
              </div>

            {%- when 'weight' -%}
              <div class="product-info__block product-info__block--sm product-info__weight" data-dynamic-variant-content="{{ section.id }}-{{ block.id }}"{% unless current_variant.weight > 0 %} hidden{% endunless %} {{ block.shopify_attributes }}>
                {% if current_variant.weight > 0 %}
                  {{ current_variant.weight | weight_with_unit: current_variant.weight_unit }}
                {% endif %}
              </div>

            {%- when 'barcode' -%}
              {%- if product -%}
                <div class="product-info__block product-info__block--sm product-info__barcode" data-dynamic-variant-content="{{ section.id }}-{{ block.id }}"{% if current_variant.barcode == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
                  <span class="product-info-label font-bold">{{ 'products.product.barcode' | t }}</span>
                  <span class="product-info__barcode-value">{% if current_variant.barcode %}{{ current_variant.barcode }}{% endif %}</span>
                </div>
              {%- elsif product == blank -%}
                <div class="product-info__block product-info__block--sm product-info__barcode" {{ block.shopify_attributes }}>
                  <span class="product-info-label font-bold">{{ 'products.product.barcode' | t }}</span>
                  <span class="product-info__barcode-value">1234567890</span>
                </div>
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product-info__block product-info__block--sm product-price" {{ block.shopify_attributes }}>
                <div class="product-info__price" data-dynamic-variant-content="{{ section.id }}-{{ block.id }}-price">
                  {% render 'price', product: product, current_variant: current_variant, use_variant: true, show_sale_color: settings.sale_price_color_pdp, class: 'text-h3' %}
                </div>
                {%- if product != blank -%}
                  {%- if block.settings.show_tax_and_shipping -%}
                    {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                      <div class="product-policies text-sm rte" data-dynamic-variant-content="{{ section.id }}-{{ block.id }}-policies">
                        {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                          {{- 'cart.general.taxes_included_shipping_at_checkout_html' | t: link: shop.shipping_policy.url -}}
                        {%- elsif cart.taxes_included -%}
                          {{- 'cart.general.taxes_included_shipping_at_checkout' | t -}}
                        {%- elsif shop.shipping_policy.body != blank -%}
                          {{- 'cart.general.taxes_and_shipping_at_checkout_html' | t: link: shop.shipping_policy.url -}}
                        {%- else -%}
                          {{- 'cart.general.taxes_and_shipping_at_checkout' | t -}}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endif -%}

                  {%- assign instalments_form_id = 'instalments-form-' | append: section.id -%}
                  {%- form 'product', product, class: 'js-instalments-form text-sm mt-2', id: instalments_form_id -%}
                    <input type="hidden" name="id" value="{% if current_variant %}{{ current_variant.id }}{% endif %}" data-dynamic-variant-content="{{ section.id }}-{{ block.id }}-input-id">
                    {{ form | payment_terms }}
                  {%- endform -%}
                {%- endif -%}
              </div>

            {%- when 'rating' -%}
              <div class="product-info__block product-info__block--sm product-info__rating" data-dynamic-product-content="{{ section.id }}-{{ block.id }}"{% if product != blank and product.metafields.reviews.rating.value == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
                {%- if product.metafields.reviews.rating.value != blank -%}
                  {% render 'rating',
                    rating_value: product.metafields.reviews.rating.value,
                    rating_count: product.metafields.reviews.rating_count
                  %}
                {%- elsif product == blank -%}
                  <div class="rating inline-block align-middle" role="img" aria-label="0 out of 5 stars">
                    <span class="rating__stars" aria-hidden="true" style="--rating: 0; --rating-max: 5;">★★★★★</span>
                  </div>
                  <div class="rating__count inline-block align-middle text-sm">(0)</div>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              {%- if block.settings.show_as_collapsible_content -%}
                <details-disclosure {{ block.shopify_attributes }}>
                  <details class="disclosure disclosure--row"{% if block.settings.open %} open{% endif %}>
                    <summary>
                      <div class="flex justify-between items-center" data-dynamic-product-content="{{ section.id }}-{{ block.id }}-summary">
                        <h2 class="disclosure__title product-info__disclosure font-body font-bold text-body flex flex-auto items-center mb-0">
                          {%- if block.settings.icon != 'none' -%}
                            {% render 'icon', icon: block.settings.icon, width: 22, height: 22 %}
                          {%- endif -%}
                          {{ 'products.product.description' | t }}
                        </h2>
                        <span class="disclosure__toggle">
                        {%- if settings.disclosure_toggle == 'plus' -%}
                          {% render 'icon-plus' %}
                        {%- else -%}
                          {% render 'icon-chevron-down' %}
                        {%- endif -%}
                      </span>
                      </div>
                    </summary>
                    <div class="disclosure__panel has-motion">
                      <div class="disclosure__content rte" data-dynamic-product-content="{{ section.id }}-{{ block.id }}-content">
                        {{ block.settings.text | default: product.description }}
                      </div>
                    </div>
                  </details>
                </details-disclosure>
              {%- else -%}
                <div class="product-info__block product-info__block--sm rte product-description" data-dynamic-product-content="{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text | default: product.description }}
                </div>
              {%- endif -%}

            {%- when 'variant-picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="product-info__block product-options" data-dynamic-variant-content="{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                  {% render 'variant-picker',
                    product: product,
                    current_variant: current_variant,
                    product_form_id: product_form_id,
                    block: block,
                    media_ratio: media_ratio,
                    swatch_crop: section.settings.media_crop
                  %}
                </div>
              {%- endunless -%}

              {%- if block.settings.show_backorder_text -%}
                <div class="product-info__block product-backorder" data-dynamic-variant-content="{{ section.id }}-{{ block.id }}-backorder">
                  {% render 'backorder', product: product, variant: current_variant %}
                </div>
              {%- endif -%}

            {%- when 'inventory-status' -%}
              {%- if current_variant.inventory_management != blank -%}
                {% render 'product-inventory', product: product, current_variant: current_variant, block: block %}
              {%- endif -%}

            {%- when 'buy-buttons' -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                <product-form>
                  {%- if product != blank -%}
                    {% form 'product', product,
                      class: 'js-product-form js-product-form-main',
                      id: product_form_id,
                      novalidate: 'novalidate'
                    -%}
                      {%- liquid
                        assign gift_card_recipient_feature_active = false
                        if block.settings.show_gift_card_recipient and product.gift_card?
                          assign gift_card_recipient_feature_active = true
                        endif

                        assign enable_dynamic_checkout = false
                        if block.settings.enable_dynamic_checkout and product.selling_plan_groups == empty and gift_card_recipient_feature_active == false
                          unless product.template_suffix contains 'preorder'
                            assign enable_dynamic_checkout = true
                          endunless
                        endif
                      -%}

                      {%- if gift_card_recipient_feature_active -%}
                        {% render 'gift-card-recipient', section: section %}
                      {%- endif -%}

                      <div class="alert mb-8 bg-error-bg text-error-text js-form-error text-start" role="alert" hidden></div>

                      <input type="hidden" name="id" value="{% if current_variant %}{{ current_variant.id }}{% endif %}" data-dynamic-variant-content="{{ section.id }}-{{ block.id }}-input-id" required>
                      <div class="product-info__add-to-cart flex{% if enable_dynamic_checkout %} qty-input--secondary-btn{% endif %}">
                        {%- if block.settings.show_qty_selector -%}
                          {% render 'quantity-input', layout_style: 'combined' %}
                        {%- else -%}
                          <input type="hidden" name="quantity" value="1">
                        {%- endif -%}

                        <div class="product-info__add-button">
                          {%- capture add_to_cart_text -%}
                            {%- if product.template_suffix contains 'preorder' -%}
                              {{- 'products.product.preorder' | t -}}
                            {%- else -%}
                              {{- 'products.product.add_to_cart' | t -}}
                            {%- endif -%}
                          {%- endcapture -%}

                          <button
                            type="submit"
                            data-add-to-cart-text="{{ add_to_cart_text | escape }}"
                            class="btn {% if enable_dynamic_checkout %}btn--secondary{% else %}btn--primary{% endif %} w-full"
                            name="add"
                            data-preselection-disabled="true"
                            data-preselection-text="{{ 'products.variant.not_selected' | t | escape }}"
                            {%- unless current_variant.available %} disabled{% endunless %}>
                            {%- if current_variant.available -%}
                              {{- add_to_cart_text -}}
                            {%- else -%}
                              {{- 'products.variant.no_stock' | t -}}
                            {%- endif -%}
                          </button>
                        </div>
                      </div>

                      {%- if enable_dynamic_checkout -%}
                        <div class="product-info__dynamic-checkout-btn mt-4">
                          {{ form | payment_button }}
                        </div>
                      {%- endif -%}

                    {%- endform -%}
                  {%- else -%}
                    <div class="product-info__add-to-cart flex">
                      {% render 'quantity-input', layout_style: 'combined' %}
                      <div class="product-info__add-button">
                        <button class="btn btn--primary w-full" disabled>
                          {{- 'products.product.add_to_cart' | t -}}
                        </button>
                      </div>
                    </div>
                  {%- endif -%}
                </product-form>
              </div>

            {%- when 'share' -%}
              <div class="product-info__block" data-dynamic-product-content="{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                <div class="social-share flex items-center">
                  <p class="social-share__heading mb-0 font-bold">{{ 'general.social.share_heading' | t }}:</p>
                  {% render 'social-share', share_title: product.title, share_url: product.url, share_image: product %}
                </div>
              </div>

            {%- when 'richtext' -%}
              <div class="product-info__block rte" data-dynamic-product-content="{{ section.id }}-{{ block.id }}"{% if block.settings.richtext == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
                {{ block.settings.richtext }}
              </div>

            {%- when 'complementary' -%}
              <div class="product-info__block" data-dynamic-product-content="{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                {%- liquid
                  if block.settings.layout == 'carousel'
                    assign grid_classes = 'grid grid-flow-col auto-cols-1 gap-x-theme'
                  endif
                -%}
                {%- render 'recommendations',
                      product: product,
                      intent: 'complementary',
                      products_to_show: block.settings.products_to_show,
                      heading: block.settings.heading,
                      layout: block.settings.layout,
                      grid_classes: grid_classes
                -%}
              </div>

            {%- when 'image' -%}
              <div class="product-info__block" data-dynamic-product-content="{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.title -%}
                  <p class="h4">{{ block.settings.title }}</p>
                {%- endif -%}

                <div class="flex {{ block.settings.image_align }}">
                  <div class="media relative" style="width: {{ block.settings.image_width }}px;">
                    {%- if block.settings.image != blank -%}
                      {%- if block.settings.url != blank -%}
                        <a href="{{ block.settings.url }}">
                      {%- endif -%}
                      {% render 'image',
                              image: block.settings.image,
                              src_width: block.settings.image_width,
                              srcset_2x: true
                      %}
                      {%- if block.settings.url != blank -%}
                        </a>
                      {%- endif -%}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'media__placeholder' }}
                    {%- endif -%}
                  </div>
                </div>
              </div>

            {%- when 'pop-up' -%}
              <div class="product-info__block" data-dynamic-product-content="{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                <modal-opener class="no-js-hidden" data-modal="modal-{{ block.id }}">
                  <button type="button" class="{{ block.settings.link_style }}" aria-haspopup="dialog">
                    {{- block.settings.link_text -}}
                  </button>
                </modal-opener>
                <a href="{{ block.settings.page.url }}" class="link js-hidden">{{ block.settings.link_text }}</a>
              </div>

            {%- when 'custom-liquid' -%}
              <div class="product-info__block"{% if block.settings.variant_content %} data-dynamic-variant-content="{{ section.id }}-{{ block.id }}"{% endif %}{% if block.settings.custom_liquid == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>

            {%- when 'divider' -%}
              <hr class="mt-6 mb-6{% unless block.settings.show_line %} invisible{% endunless %}" {{ block.shopify_attributes }}>

            {%- when 'view-more-button' -%}
              {%- if block.settings.button_label != blank -%}
                <div class="product-info__block product-info__block--md {{ block.settings.text_align }}" data-dynamic-product-content="{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                  <a class="link" href="{{ product.url }}">
                    {{- block.settings.button_label | escape -}}
                  </a>
                </div>
              {%- endif -%}

            {%- when 'collapsible-content' -%}
              {%- if block.settings.text != blank or block.settings.page.content != blank -%}
                <details-disclosure {{ block.shopify_attributes }}>
                  <details class="disclosure disclosure--row"{% if block.settings.open %} open{% endif %}>
                    <summary>
                      <div class="flex justify-between items-center" data-dynamic-product-content="{{ section.id }}-{{ block.id }}-summary">
                        <h2 class="disclosure__title product-info__disclosure font-body font-bold text-body flex flex-auto items-center mb-0">
                          {%- if block.settings.icon != 'none' -%}
                            {% render 'icon', icon: block.settings.icon, width: 28, height: 28 %}
                          {%- endif -%}
                          {{- block.settings.heading | default: block.settings.page.title -}}
                        </h2>
                        <span class="disclosure__toggle">
                        {%- if settings.disclosure_toggle == 'plus' -%}
                          {% render 'icon-plus' %}
                        {%- else -%}
                          {% render 'icon-chevron-down' %}
                        {%- endif -%}
                      </span>
                      </div>
                    </summary>
                    <div class="disclosure__panel has-motion">
                      <div class="disclosure__content rte" data-dynamic-product-content="{{ section.id }}-{{ block.id }}-content">
                        {{ block.settings.text }}
                        {{ block.settings.page.content }}
                      </div>
                    </div>
                  </details>
                </details-disclosure>
              {%- endif -%}

            {%- when 'product-labels' -%}
              {%- liquid
                capture variant_labels
                  render 'product-label', product: product, variant: current_variant, is_product_card: false, limit: 99
                endcapture
              -%}

              <div class="product-info__block product-info__block--sm" data-dynamic-variant-content="{{ section.id }}-{{ block.id }}"{% if variant_labels == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
                {%- if variant_labels != blank -%}
                  {{ variant_labels }}
                {%- endif -%}
              </div>

            {%- when 'countdown-timer' -%}
              {%- liquid
                assign end_date = block.settings.end_date | default: '2026-12-31'
                assign end_time = block.settings.end_time | default: '23:59'
                assign end_datetime = end_date | append: 'T' | append: end_time | append: ':00'
              -%}
              {%- assign countdown_cs = block.settings.color_scheme -%}
              {%- liquid
                assign countdown_inline_style = ''
                if block.settings.bg_color != blank and block.settings.bg_color != 'rgba(0,0,0,0)'
                  assign countdown_inline_style = 'background-color: ' | append: block.settings.bg_color | append: ';'
                endif
                if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)'
                  assign countdown_inline_style = countdown_inline_style | append: ' color: ' | append: block.settings.text_color | append: ';'
                endif
              -%}
              <div class="product-info__block product-info__countdown{% unless countdown_cs == 'none' %} color-scheme color-scheme--{{ countdown_cs }} rounded p-4{% endunless %}"{% if countdown_inline_style != '' %} style="{{ countdown_inline_style }}"{% endif %} {{ block.shopify_attributes }}>
                <countdown-timer class="countdown-timer flex items-center flex-wrap gap-2" role="timer" data-end-date="{{ end_datetime }}">
                  {%- if block.settings.label != blank -%}
                    <span class="countdown-label" style="color: {{ block.settings.label_color }};">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                        <line x1="7" y1="7" x2="7.01" y2="7"/>
                      </svg>
                      <strong>{{ block.settings.label | escape }}</strong>
                    </span>
                  {%- endif -%}
                  <span class="countdown-number js-days" style="background-color: {{ block.settings.number_bg }}; color: {{ block.settings.number_color }};">00</span>
                  <span class="countdown-sep">:</span>
                  <span class="countdown-number js-hours" style="background-color: {{ block.settings.number_bg }}; color: {{ block.settings.number_color }};">00</span>
                  <span class="countdown-sep">:</span>
                  <span class="countdown-number js-mins" style="background-color: {{ block.settings.number_bg }}; color: {{ block.settings.number_color }};">00</span>
                  <span class="countdown-sep">:</span>
                  <span class="countdown-number js-secs" style="background-color: {{ block.settings.number_bg }}; color: {{ block.settings.number_color }};">00</span>
                </countdown-timer>
              </div>

            {%- when 'heading' -%}
              {%- assign heading_cs = block.settings.color_scheme -%}
              <div class="product-info__block product-info__block--sm{% unless heading_cs == 'none' %} color-scheme color-scheme--{{ heading_cs }} rounded p-4{% endunless %}" {{ block.shopify_attributes }}>
                {%- case block.settings.heading_tag -%}
                  {%- when 'h2' -%}<h2 class="{{ block.settings.heading_size }} mb-0">{{ block.settings.heading | escape }}</h2>
                  {%- when 'h3' -%}<h3 class="{{ block.settings.heading_size }} mb-0">{{ block.settings.heading | escape }}</h3>
                  {%- when 'h4' -%}<h4 class="{{ block.settings.heading_size }} mb-0">{{ block.settings.heading | escape }}</h4>
                  {%- when 'h5' -%}<h5 class="{{ block.settings.heading_size }} mb-0">{{ block.settings.heading | escape }}</h5>
                {%- endcase -%}
              </div>

            {%- when 'icon-text' -%}
              {%- liquid
                assign open_grid = false
                assign close_grid = false
                if forloop.index0 == 0
                  assign open_grid = true
                else
                  assign prev_idx = forloop.index0 | minus: 1
                  assign prev_block = section.blocks[prev_idx]
                  if prev_block.type != 'icon-text'
                    assign open_grid = true
                  endif
                endif
                assign next_block = section.blocks[forloop.index]
                if next_block == nil or next_block.type != 'icon-text'
                  assign close_grid = true
                endif
              -%}
              {%- assign icon_cs = block.settings.color_scheme -%}
              {%- if open_grid -%}<div class="product-info__block{% unless icon_cs == 'none' %} color-scheme color-scheme--{{ icon_cs }} rounded p-4{% endunless %}"><div class="product-info__icon-grid">{%- endif -%}
                <div class="product-info__icon-item" {{ block.shopify_attributes }}>
                  <div class="icon-item__badge">
                    {%- if block.settings.icon_image != blank -%}
                      {% render 'image', image: block.settings.icon_image, width: 56, height: 56 %}
                    {%- else -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 44 44" aria-hidden="true">
                        <circle cx="22" cy="22" r="20" fill="#f5f5f5" stroke="#ccc" stroke-width="1.5"/>
                        <text x="22" y="22" font-family="sans-serif" font-size="8" font-weight="600" fill="#999" text-anchor="middle" dominant-baseline="middle">{{ block.settings.icon_label | default: 'ICON' | upcase | truncate: 6, '' }}</text>
                      </svg>
                    {%- endif -%}
                  </div>
                  <p class="icon-item__label">{{ block.settings.label | escape }}</p>
                </div>
              {%- if close_grid -%}</div></div>{%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- render 'product-popups', current_variant: current_variant -%}

{%- if first_3d_model -%}
  <script type="application/json" id="product-json-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
{%- endif -%}

{%- unless product == blank -%}
  {% render 'structured-data-product', product: product, current_variant: current_variant %}
{%- endunless -%}

{% schema %}
{
  "name": "Featured product",
  "tag": "section",
  "class": "cc-featured-product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Media"
