
{%- if request.page_type == 'index' or section.settings.announcement_homepage_only == false -%}
  {%- liquid
    assign show_localization = false
    if section.settings.enable_country_selector or section.settings.enable_language_selector
      assign show_localization = true
    endif
  -%}

  {%- if section.settings.link1 or section.settings.link2 or show_localization or section.blocks.size > 0 -%}
    {{ 'announcement.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'announcement.js' | asset_url }}" defer="defer"></script>

    {%- style -%}
      .announcement {
        --announcement-text-color: {{ section.settings.text_color.rgb }};
        background-color: {{ section.settings.bg_color }};
      }
    {%- endstyle -%}

    {%- if show_localization -%}
      <script src="{{ 'custom-select.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <announcement-bar class="announcement block text-body-{{ section.settings.text_type_scale }}" data-slide-delay="{{- section.settings.read_time | times: 1000 -}}">
      {%- if section.blocks.size > 1 -%}
        <button class="announcement__arrow announcement__arrow--prev js-announcement-prev" aria-label="Previous announcement" type="button">
          {% render 'icon-chevron-left' %}
        </button>
      {%- endif -%}
      <div class="container">
        <div class="flex">
          <div class="announcement__col--left announcement__col--align-center{% if section.blocks.size > 1 %} announcement__slider{% endif %}"{% if section.blocks.size > 1 %} aria-roledescription="carousel" aria-live="off"{% endif %}>
            {%- for block in section.blocks -%}
              {%- case block.type -%}

                {%- when 'announcement' -%}
                  <div class="announcement__text flex items-center m-0" {{ block.shopify_attributes }}{% if section.blocks.size > 1 %} aria-roledescription="slide"{% endif %}>
                    <div class="rte">{{- block.settings.text -}}</div>
                  </div>

                {%- when 'promo_code' -%}
                  {%- liquid
                    assign pc_text = block.settings.text | default: ''
                    assign pc_has_countdown = false
                    if pc_text contains '{count_down}'
                      assign pc_has_countdown = true
                    endif

                    if pc_has_countdown
                      assign cd_year = block.settings.countdown_year | default: 2026
                      assign cd_month = block.settings.countdown_month | default: '12'
                      assign cd_day_num = block.settings.countdown_day | default: 1
                      assign cd_day_str = cd_day_num | append: ''
                      if cd_day_num < 10
                        assign cd_day_str = '0' | append: cd_day_str
                      endif
                      assign cd_hour = block.settings.countdown_hour | default: '00'
                      assign cd_minute = block.settings.countdown_minute | default: '00'
                      assign cd_tz = block.settings.countdown_timezone | default: '+00:00'
                      assign cd_end_date = cd_year | append: '-' | append: cd_month | append: '-' | append: cd_day_str | append: 'T' | append: cd_hour | append: ':' | append: cd_minute | append: ':00' | append: cd_tz
                    endif

                    assign coupon_styles = ''
                    if block.settings.coupon_code_text_light.alpha > 0
                      assign coupon_styles = coupon_styles | append: '--coupon-text-light:' | append: block.settings.coupon_code_text_light | append: ';'
                    endif
                    if block.settings.coupon_code_text_dark.alpha > 0
                      assign coupon_styles = coupon_styles | append: '--coupon-text-dark:' | append: block.settings.coupon_code_text_dark | append: ';'
                    endif
                  -%}
                  <div class="announcement__text announcement__text--promo flex items-center m-0" {{ block.shopify_attributes }}{% if section.blocks.size > 1 %} aria-roledescription="slide"{% endif %}>
                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}" class="announcement__promo-link"{% if block.settings.link_new_tab %} target="_blank" rel="noopener"{% endif %}>
                    {%- endif -%}

                    {%- if block.settings.icon_image != blank -%}
                      <span class="announcement__icon">{{ block.settings.icon_image | image_url: width: 32 | image_tag: width: 16, height: 16, loading: 'lazy' }}</span>
                    {%- elsif block.settings.icon_custom != blank -%}
                      <span class="announcement__icon">{% render 'icon', icon: block.settings.icon_custom, width: 16, height: 16 %}</span>
                    {%- elsif block.settings.icon != 'none' -%}
                      <span class="announcement__icon">{% render 'icon', icon: block.settings.icon, width: 16, height: 16 %}</span>
                    {%- endif -%}

                    <span class="announcement__promo-text">
                      {%- if pc_has_countdown -%}
                        {%- assign text_parts = pc_text | split: '{count_down}' -%}
                        {{- text_parts[0] -}}<span class="announcement__countdown" data-end-date="{{ cd_end_date }}"><span class="announcement__countdown-unit"><span class="js-cd-days">0</span></span><span class="announcement__countdown-sep">:</span><span class="announcement__countdown-unit"><span class="js-cd-hours">00</span></span><span class="announcement__countdown-sep">:</span><span class="announcement__countdown-unit"><span class="js-cd-mins">00</span></span><span class="announcement__countdown-sep">:</span><span class="announcement__countdown-unit"><span class="js-cd-secs">00</span></span></span>{{- text_parts[1] -}}
                      {%- else -%}
                        {{- pc_text -}}
                      {%- endif -%}
                    </span>

                    {%- if block.settings.coupon_code != blank -%}
                      <button type="button" class="announcement__coupon js-copy-coupon" data-code="{{ block.settings.coupon_code | escape }}"{% if coupon_styles != blank %} style="{{ coupon_styles }}"{% endif %} aria-label="Copy coupon code {{ block.settings.coupon_code | escape }}">
                        <span class="announcement__coupon-code">{{ block.settings.coupon_code }}</span>
                        <span class="announcement__coupon-icon" aria-hidden="true">{% render 'icon-copy' %}</span>
                        <span class="announcement__coupon-copied" aria-live="polite" hidden>Copied!</span>
                      </button>
                    {%- endif -%}

                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  </div>

                {%- when 'free_shipping' -%}
                  {%- liquid
                    assign fs_goal = block.settings.free_shipping_amount | default: 0 | plus: 0
                    assign fs_goal_cents = fs_goal | times: 100
                    assign fs_money_goal = fs_goal_cents | money

                    if cart.item_count == 0 or fs_goal == 0
                      assign fs_state = 'default'
                    elsif cart.total_price >= fs_goal_cents
                      assign fs_state = 'success'
                    else
                      assign fs_state = 'progress'
                    endif

                    case fs_state
                      when 'default'
                        assign fs_msg = block.settings.default_message | replace: '{fs_amount}', fs_money_goal
                      when 'success'
                        assign fs_msg = block.settings.success_message
                      when 'progress'
                        assign fs_deficit_cents = fs_goal_cents | minus: cart.total_price
                        assign fs_deficit_money = fs_deficit_cents | money
                        assign fs_msg = block.settings.progress_message | replace: '{amount_to_fs}', fs_deficit_money
                    endcase
                  -%}
                  <div class="announcement__text announcement__text--free-shipping flex items-center m-0" {{ block.shopify_attributes }}{% if section.blocks.size > 1 %} aria-roledescription="slide"{% endif %}
                    data-fs-goal="{{ fs_goal_cents }}"
                    data-fs-default="{{ block.settings.default_message | escape }}"
                    data-fs-progress="{{ block.settings.progress_message | escape }}"
                    data-fs-success="{{ block.settings.success_message | escape }}"
                    data-fs-money-goal="{{ fs_money_goal | escape }}">

                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}" class="announcement__fs-link"{% if block.settings.link_new_tab %} target="_blank" rel="noopener"{% endif %}>
                    {%- endif -%}

                    {%- if block.settings.icon_image != blank -%}
                      <span class="announcement__icon">{{ block.settings.icon_image | image_url: width: 32 | image_tag: width: 16, height: 16, loading: 'lazy' }}</span>
                    {%- elsif block.settings.icon_custom != blank -%}
                      <span class="announcement__icon">{% render 'icon', icon: block.settings.icon_custom, width: 16, height: 16 %}</span>
                    {%- elsif block.settings.icon != 'none' -%}
                      <span class="announcement__icon">{% render 'icon', icon: block.settings.icon, width: 16, height: 16 %}</span>
                    {%- endif -%}

                    <span class="js-fs-message">{{ fs_msg }}</span>

                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  </div>

              {%- endcase -%}
            {%- endfor -%}
          </div>

          {% if section.settings.link1 or section.settings.link2 or show_localization %}
            <div class="announcement__col--right hidden md:flex md:items-center">
              {%- if section.settings.link1 or section.settings.link2 -%}
                {%- if section.settings.link1 -%}
                  <a href="{{ section.settings.link1 }}" class="js-announcement-link font-bold{% if section.settings.link2 == blank and show_localization == false %} no-spacer{% endif %}">
                    {%- if section.settings.link1_label != blank -%}
                      {{- section.settings.link1_label | escape -}}
                    {%- else -%}
                      {{- section.settings.link1 -}}
                    {%- endif -%}
                  </a>
                {%- endif -%}

                {%- if section.settings.link2 -%}
                  <a href="{{ section.settings.link2 }}" class="js-announcement-link font-bold{% unless show_localization %} no-spacer{% endunless %}">
                    {%- if section.settings.link2_label != blank -%}
                      {{- section.settings.link2_label | escape -}}
                    {%- else -%}
                      {{- section.settings.link2 -}}
                    {%- endif -%}
                  </a>
                {%- endif -%}
              {%- endif -%}

              {%- if show_localization -%}
                <div class="announcement__localization">
                  {% render 'localization-form', id: 'nav-localization', hide_labels: true %}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
      {%- if section.blocks.size > 1 -%}
        <button class="announcement__arrow announcement__arrow--next js-announcement-next" aria-label="Next announcement" type="button">
          {% render 'icon-chevron-right' %}
        </button>
      {%- endif -%}
    </announcement-bar>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement",
  "class": "cc-announcement",
  "settings": [
    {
      "type": "paragraph",
      "content": "The links and country/currency selectors will appear inside the navigation menu on mobile."
    },
    {
      "type": "checkbox",
      "id": "announcement_homepage_only",
      "label": "Show only on homepage",
      "info": "Links and country/currency selectors will also only show on the homepage.",
      "default": false
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "url",
      "id": "link1",
      "label": "Link 1"
    },
    {
      "type": "text",
      "id": "link1_label",
      "label": "Link 1 label"
    },
    {
      "type": "url",
      "id": "link2",
      "label": "Link 2"
    },
    {
      "type": "text",
      "id": "link2_label",
      "label": "Link 2 label"
    },
    {
      "type": "paragraph",
      "content": "Links will appear inside the mobile menu on smaller screens."
    },
    {
      "type": "header",
      "content": "Country/Region selector",
      "info": "To add a country/region, go to your [payment settings](/admin/settings/payments)"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country/region selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Language selector",
      "info": "To add a language, go to your [language settings](/admin/settings/languages)"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable language selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#EBEBEB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "select",
      "id": "text_type_scale",
      "label": "Text size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "read_time",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Announcement read time",
      "default": 7
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Welcome to our store. <a href='#' title='#'>Learn more</a></p>",
          "info": "If you have multiple announcements, keep them short as they may wrap on smaller screens."
        }
      ]
    },
    {
      "type": "promo_code",
      "name": "Promo code",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "gift", "label": "Gift" },
            { "value": "percent", "label": "Percent" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "star", "label": "Star" },
            { "value": "clock", "label": "Clock" },
            { "value": "heart", "label": "Heart" },
            { "value": "email", "label": "Email" },
            { "value": "phone", "label": "Phone" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "icon_custom",
          "label": "Use another icon",
          "info": "If you want to use different icons from the options above, look for an icon from our icon list and fill the icon name here (E.g: badminton)."
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Hurry up! 30% OFF Sale Ends Soon {count_down}",
          "info": "Use {count_down} to show countdown timer."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "link_new_tab",
          "label": "Open this link in a new tab",
          "default": false
        },
        {
          "type": "text",
          "id": "coupon_code",
          "label": "Coupon code"
        },
        {
          "type": "color",
          "id": "coupon_code_text_light",
          "label": "Coupon code text (light)"
        },
        {
          "type": "color",
          "id": "coupon_code_text_dark",
          "label": "Coupon code text (dark)"
        },
        {
          "type": "header",
          "content": "Countdown timer"
        },
        {
          "type": "paragraph",
          "content": "Set up exact time to stop the countdown on the announcement bar."
        },
        {
          "type": "select",
          "id": "countdown_timezone",
          "label": "Time zone",
          "options": [
            { "value": "-12:00", "label": "GMT -12:00" },
            { "value": "-11:00", "label": "GMT -11:00" },
            { "value": "-10:00", "label": "GMT -10:00" },
            { "value": "-09:30", "label": "GMT -09:30" },
            { "value": "-09:00", "label": "GMT -09:00" },
            { "value": "-08:00", "label": "GMT -08:00" },
            { "value": "-07:00", "label": "GMT -07:00" },
            { "value": "-06:00", "label": "GMT -06:00" },
            { "value": "-05:00", "label": "GMT -05:00" },
            { "value": "-04:00", "label": "GMT -04:00" },
            { "value": "-03:30", "label": "GMT -03:30" },
            { "value": "-03:00", "label": "GMT -03:00" },
            { "value": "-02:00", "label": "GMT -02:00" },
            { "value": "-01:00", "label": "GMT -01:00" },
            { "value": "+00:00", "label": "GMT +00:00" },
            { "value": "+01:00", "label": "GMT +01:00" },
            { "value": "+02:00", "label": "GMT +02:00" },
            { "value": "+03:00", "label": "GMT +03:00" },
            { "value": "+03:30", "label": "GMT +03:30" },
            { "value": "+04:00", "label": "GMT +04:00" },
            { "value": "+04:30", "label": "GMT +04:30" },
            { "value": "+05:00", "label": "GMT +05:00" },
            { "value": "+05:30", "label": "GMT +05:30" },
            { "value": "+05:45", "label": "GMT +05:45" },
            { "value": "+06:00", "label": "GMT +06:00" },
            { "value": "+06:30", "label": "GMT +06:30" },
            { "value": "+07:00", "label": "GMT +07:00" },
            { "value": "+08:00", "label": "GMT +08:00" },
            { "value": "+08:45", "label": "GMT +08:45" },
            { "value": "+09:00", "label": "GMT +09:00" },
            { "value": "+09:30", "label": "GMT +09:30" },
            { "value": "+10:00", "label": "GMT +10:00" },
            { "value": "+10:30", "label": "GMT +10:30" },
            { "value": "+11:00", "label": "GMT +11:00" },
            { "value": "+12:00", "label": "GMT +12:00" },
            { "value": "+12:45", "label": "GMT +12:45" },
            { "value": "+13:00", "label": "GMT +13:00" },
            { "value": "+14:00", "label": "GMT +14:00" }
          ],
          "default": "-04:00"
        },
        {
          "type": "number",
          "id": "countdown_year",
          "label": "Year",
          "default": 2026
        },
        {
          "type": "select",
          "id": "countdown_month",
          "label": "Month",
          "options": [
            { "value": "01", "label": "January" },
            { "value": "02", "label": "February" },
            { "value": "03", "label": "March" },
            { "value": "04", "label": "April" },
            { "value": "05", "label": "May" },
            { "value": "06", "label": "June" },
            { "value": "07", "label": "July" },
            { "value": "08", "label": "August" },
            { "value": "09", "label": "September" },
            { "value": "10", "label": "October" },
            { "value": "11", "label": "November" },
            { "value": "12", "label": "December" }
          ],
          "default": "12"
        },
        {
          "type": "number",
          "id": "countdown_day",
          "label": "Day",
          "default": 1
        },
        {
          "type": "select",
          "id": "countdown_hour",
          "label": "Hour",
          "options": [
            { "value": "00", "label": "12 AM" },
            { "value": "01", "label": "01 AM" },
            { "value": "02", "label": "02 AM" },
            { "value": "03", "label": "03 AM" },
            { "value": "04", "label": "04 AM" },
            { "value": "05", "label": "05 AM" },
            { "value": "06", "label": "06 AM" },
            { "value": "07", "label": "07 AM" },
            { "value": "08", "label": "08 AM" },
            { "value": "09", "label": "09 AM" },
            { "value": "10", "label": "10 AM" },
            { "value": "11", "label": "11 AM" },
            { "value": "12", "label": "12 PM" },
            { "value": "13", "label": "01 PM" },
            { "value": "14", "label": "02 PM" },
            { "value": "15", "label": "03 PM" },
            { "value": "16", "label": "04 PM" },
            { "value": "17", "label": "05 PM" },
            { "value": "18", "label": "06 PM" },
            { "value": "19", "label": "07 PM" },
            { "value": "20", "label": "08 PM" },
            { "value": "21", "label": "09 PM" },
            { "value": "22", "label": "10 PM" },
            { "value": "23", "label": "11 PM" }
          ],
          "default": "01"
        },
        {
          "type": "select",
          "id": "countdown_minute",
          "label": "Minute",
          "options": [
            { "value": "00", "label": "00" },
            { "value": "15", "label": "15" },
            { "value": "30", "label": "30" },
            { "value": "45", "label": "45" }
          ],
          "default": "00"
        }
      ]
    },
    {
      "type": "free_shipping",
      "name": "Free shipping",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "box", "label": "Box" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "gift", "label": "Gift" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "star", "label": "Star" },
            { "value": "plane", "label": "Plane" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "icon_custom",
          "label": "Use another icon",
          "info": "If you want to use different icons from the options above, look for an icon from our icon list and fill the icon name here (E.g: badminton)."
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image"
        },
        {
          "type": "text",
          "id": "default_message",
          "label": "Default message",
          "default": "Free Shipping for all orders over {fs_amount}",
          "info": "Display when cart is empty."
        },
        {
          "type": "text",
          "id": "progress_message",
          "label": "Progress message",
          "default": "Only {amount_to_fs} away from free shipping",
          "info": "Display when cart subtotal is less than free shipping goal. Use {amount_to_fs} to show the remaining amount needed for free shipping."
        },
        {
          "type": "text",
          "id": "success_message",
          "label": "Success message",
          "default": "Congratulations! Your orders are free shipped!",
          "info": "Display when cart subtotal is equal to or greater than free shipping goal."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "link_new_tab",
          "label": "Open this link in a new tab",
          "default": false
        },
        {
          "type": "number",
          "id": "free_shipping_amount",
          "label": "Free shipping goal",
          "info": "Enter the minimum order amount (in your store's currency) to qualify for free shipping.",
          "default": 50
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}
