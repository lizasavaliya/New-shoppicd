{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'slideshow.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'text-overlay.css' | asset_url }}" media="print" onload="this.media='all'">
{%- else -%}
  {{ 'slideshow.css' | asset_url | stylesheet_tag }}
  {{ 'text-overlay.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.blocks.size > 1 -%}
  <script src="{{ 'slideshow.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  # constants
  assign gutter_lg = 64
  assign breakpoint_sm = 600
  assign breakpoint_xxl = 1536

  assign breakpoint_sm_down = breakpoint_sm | minus: 0.02
  assign breakpoint_page = settings.max_page_width | default: 1320 | plus: gutter_lg | plus: gutter_lg

  assign color_scheme = section.settings.color_scheme
  assign bg_color = false

  if color_scheme == 'default'
    assign bg_color = settings.bg_color
  elsif color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg_grad | default: settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg_grad | default: settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg_grad | default: settings.color_scheme_3_bg
  endif

  if bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif

  # autoplay: speed > 0 enables it
  assign autoplay = false
  if section.settings.autoplay_speed > 0
    assign autoplay = true
  endif

  # section width
  assign is_full_width = true
  if section.settings.section_width == 'contained'
    assign is_full_width = false
  endif
-%}

{%- style -%}
  #{{ section.id }} {
    background: none;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    --image-height: {{ section.settings.fixed_height_mobile }}px;

    {%- if autoplay -%}
      --duration: {{ section.settings.autoplay_speed }}s;
      --play-state: paused;
    {%- endif -%}
  }

  #{{ section.id }} .slideshow-ctrl {
    --text-color: {{ section.settings.pagination_color.red }} {{ section.settings.pagination_color.green }} {{ section.settings.pagination_color.blue }};
  }

  #{{ section.id }} .image-banner { min-height: {{ section.settings.fixed_height_mobile }}px; }

  @media (min-width: {{ breakpoint_sm }}px) {
    #{{ section.id }} .image-banner {
      min-height: calc({{ section.settings.fixed_height_mobile }}px + ({{ section.settings.fixed_height_desktop }} - {{ section.settings.fixed_height_mobile }}) * ((100vw - {{ breakpoint_sm }}px) / {{ breakpoint_xxl | minus: breakpoint_sm }}));
    }
  }
  @media (min-width: {{ breakpoint_page }}px) {
    #{{ section.id }} .image-banner { min-height: {{ section.settings.fixed_height_desktop }}px; }
  }

  {%- if section.settings.tint_opacity > 0 or section.settings.tint_gradient != blank -%}
    #{{ section.id }} .media::after {
      {% if section.settings.tint_gradient != blank %}
        background-image: {{ section.settings.tint_gradient }};
      {% else %}
        background-color: rgba({{ section.settings.tint_color.red }}, {{ section.settings.tint_color.green }}, {{ section.settings.tint_color.blue }}, {{ section.settings.tint_opacity | divided_by: 100.0 }});
      {% endif %}
    }
  {%- endif -%}

  {%- if bg_color -%}
    #{{ section.id }} .text-overlay { background: {{ bg_color }}; }
  {%- endif -%}
{%- endstyle -%}

<div class="slideshow-section section {% if is_full_width %}section--full-width{% else %}container{% endif %}{% unless color_scheme == 'default' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}" id="{{ section.id }}">
  <slide-show class="block relative overflow-hidden" role="region" aria-roledescription="{{ 'sections.slideshow.carousel' | t }}" aria-label="{{ section.settings.accessibility_info | escape }}" data-autoplay="{{ autoplay }}" data-speed="{{ section.settings.autoplay_speed }}" data-transition="{{ section.settings.transition }}" data-pause-on-hover="{{ section.settings.pause_on_hover }}">
    <div class="slideshow flex" id="slideshow-{{ section.id }}" aria-live="polite" aria-atomic="true" tabindex="0">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image_desktop
          assign m_img = block.settings.image_mobile
          assign overlay_position = block.settings.overlay_position | split: ' '
          assign lazy_load = true
          assign fetchpriority = 'low'
          if forloop.first
            if section.index == 1 or section.settings.prevent_animation
              assign lazy_load = false
              assign fetchpriority = 'high'
            endif
          endif

          if color_scheme == "white"
            assign brightness = block.settings.transparent_content_color | color_brightness
            assign alpha = block.settings.transparent_content_color | color_extract: 'alpha'
            if brightness < 190 and alpha > 0
              assign transparent_text_contrast = "255 255 255"
              assign transparent_hover_color = block.settings.transparent_content_color | color_lighten: 10
            else
              assign transparent_text_contrast = "0 0 0"
              assign transparent_hover_color = block.settings.transparent_content_color | color_darken: 10
            endif
          endif

          assign heading_el = block.settings.heading_tag | default: 'h2'

          assign has_promos = false
          if block.settings.promo_1_product != blank or block.settings.promo_1_image != blank or block.settings.promo_2_product != blank or block.settings.promo_2_image != blank
            assign has_promos = true
          endif
        -%}

        {%- capture slide_style -%}
          {%- if color_scheme == "white" -%}
            --color-scheme-white-text: {{ block.settings.transparent_content_color.red }} {{ block.settings.transparent_content_color.green }} {{ block.settings.transparent_content_color.blue }};
            --color-scheme-white-hover: {{ transparent_hover_color.red }} {{ transparent_hover_color.green }} {{ transparent_hover_color.blue }};
            --color-scheme-white-text-contrast: {{ transparent_text_contrast }};
          {%- endif -%}
          {%- if block.settings.overlay_opacity > 0 -%}
            --slide-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
          {%- endif -%}
          {%- if block.settings.text_transform != 'none' and block.settings.text_transform != blank -%}
            --heading-transform: {{ block.settings.text_transform }};
          {%- endif -%}
        {%- endcapture -%}

        <div class="slideshow__slide slideshow__slide--ignore-pagination{% if forloop.first %} is-active{% endif %} image-banner flex w-full {{ overlay_position | last }} fixed-height{% if color_scheme == "white" %} color-scheme color-scheme--white{% endif %}" id="{{ section.id }}_{{ forloop.index }}"
             role="group" aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
             aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
             {% if slide_style != blank %}style="{{ slide_style | strip }}"{% endif %}
             {%- unless forloop.first %}tabindex="-1"{% endunless %}
             {%- if request.design_mode %}data-index="{{ forloop.index0 }}"{% endif %}
             {{ block.shopify_attributes }}>

          {%- if block.settings.url != blank -%}
            <a href="{{ block.settings.url }}" class="image-banner__image media media--has-overlay block absolute top-0 left-0 w-full h-full has-motion">
          {%- else -%}
            <div class="image-banner__image media media--has-overlay absolute top-0 left-0 w-full h-full has-motion">
          {%- endif -%}

          {%- if img != blank -%}
            {%- liquid
              if is_full_width
                assign sizes = '100vw'
              else
                capture sizes
                  render 'sizes-attribute'
                endcapture
              endif
            -%}

            {%- render 'image-desktop-and-mobile',
                class: 'img-fit',
                desktop_image: img,
                mobile_image: m_img,
                src_width_mobile: 980,
                widths_mobile: '480, 980, 1200, 1400',
                src_width_desktop: 1400,
                widths_desktop: '480, 980, 1200, 1400, 1600, 1920, 2560, 3200',
                lazy_load: lazy_load,
                fetchpriority: fetchpriority,
                sizes: sizes,
                block: block
            -%}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder dark img-fit' }}
          {%- endif -%}

          {%- if block.settings.url != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}

          {%- if block.settings.heading != blank or block.settings.subheading != blank or block.settings.text != blank or block.settings.button_1_label != blank or block.settings.button_2_label != blank or block.settings.countdown_show -%}
            <div class="slideshow__text container flex {{ overlay_position | first }}{% if block.settings.mob_center_text %} md-down:center{% endif %}{% unless bg_color %}{% if is_full_width %} md-down:p-xl{% endif %}{% endunless %}"{% if settings.animations_enabled != "disabled" and section.settings.prevent_animation == false %} data-cc-animate{% endif %}>
              <div class="text-overlay{% if bg_color %} text-overlay--bg{% endif %} {{ block.settings.overlay_text_align }}{% if block.settings.mob_center_text %} md-down:text-center{% endif %}{% if section.settings.color_scheme != "white" %}{% if is_full_width %} md-down:p-xl{% endif %}{% endif %} has-motion">
                {%- if block.settings.subheading != blank -%}
                  <p class="text-overlay__block subheading">
                    {{- block.settings.subheading | escape -}}
                  </p>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  <{{ heading_el }} class="text-overlay__heading {{ block.settings.heading_size }}{% if block.settings.text_transform != 'none' and block.settings.text_transform != blank %} text-transform--{{ block.settings.text_transform }}{% endif %}">
                    {% render 'multiline-text' with block.settings.heading %}
                  </{{ heading_el }}>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="text-overlay__block rte{% if block.settings.enlarge_text %} enlarge-text{% endif %}">
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}

                {%- if block.settings.countdown_show -%}
                  <script src="{{ 'countdown-timer.js' | asset_url }}" defer="defer"></script>
                  {% style %}
                    #{{ section.id }}_{{ forloop.index }} .countdown__block {
                      --countdown-border-radius: {{ block.settings.countdown_border_radius }}px;
                    }
                    {% if block.settings.use_custom_colors %}
                      #{{ section.id }}_{{ forloop.index }} .countdown__number {
                        --text-color: {{ block.settings.bg_color.rgba }};
                        --bg-color: {{ block.settings.count_color.rgba }};
                        {% if block.settings.count_border_color != blank and block.settings.count_border_color.alpha > 0 %}
                          --countdown-border-color: {{ block.settings.count_border_color }};
                        {% endif %}
                      }

                      {%- if block.settings.use_custom_colors and block.settings.bg_grad != blank -%}
                        #{{ section.id }}_{{ forloop.index }} .countdown__number {
                          background: {{ block.settings.bg_grad }};
                        }
                      {%- endif -%}
                    {% endif %}
                  {% endstyle %}

                  <div class="text-overlay__block countdown__block no-js-hidden pb-2{% if block.settings.use_custom_colors %} countdown-timer__custom-colors{% endif %}{% if block.settings.enlarge_end_text %} countdown-large-endtext{% endif %}">
                    {% render 'countdown-timer',
                      end_date: block.settings.countdown_end_date,
                      end_time: block.settings.countdown_end_time,
                      end_text: block.settings.countdown_end_text,
                      end_midnight: true,
                      hide_on_end: block.settings.countdown_hide_on_end
                    %}
                  </div>
                {%- endif -%}

                {%- if block.settings.button_1_label != blank or block.settings.button_2_label != blank -%}
                  <div class="text-overlay__buttons inline-flex flex-wrap items-start mt-5{% if block.settings.overlay_text_align == 'text-start' %} justify-start{% elsif block.settings.overlay_text_align == 'text-end' %} justify-end{% else %} justify-center{% endif %}{% if block.settings.mob_center_text %} md-down:center{% endif %}">
                    {%- if block.settings.button_1_label != blank -%}
                      <a class="{{ block.settings.button_1_style }}" {% if block.settings.button_1_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_1_link }}"{% endif %}{% if block.settings.button_1_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                        {{- block.settings.button_1_label | escape -}}
                      </a>
                    {%- endif -%}

                    {%- if block.settings.button_2_label != blank -%}
                      <a class="{{ block.settings.button_2_style }}" {% if block.settings.button_2_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_2_link }}"{% endif %}>
                        {{- block.settings.button_2_label | escape -}}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- if has_promos -%}
            <div class="slideshow__promos absolute">
              {%- for i in (1..2) -%}
                {%- liquid
                  if i == 1
                    assign promo_product = block.settings.promo_1_product
                    assign promo_image = block.settings.promo_1_image
                  else
                    assign promo_product = block.settings.promo_2_product
                    assign promo_image = block.settings.promo_2_image
                  endif
                -%}
                {%- if promo_product != blank or promo_image != blank -%}
                  <div class="slideshow__promo-card">
                    {%- if promo_product != blank -%}
                      <a href="{{ promo_product.url }}" class="slideshow__promo-inner block">
                        {%- if promo_product.featured_image != blank -%}
                          <div class="slideshow__promo-img">
                            {{ promo_product.featured_image | image_url: width: 600 | image_tag: class: 'img-fit', loading: 'lazy', widths: '300, 400, 600' }}
                          </div>
                        {%- else -%}
                          <div class="slideshow__promo-img slideshow__promo-img--placeholder">
                            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>
                        {%- endif -%}
                        <div class="slideshow__promo-info">
                          <p class="slideshow__promo-title">{{ promo_product.title | escape }}</p>
                          <p class="slideshow__promo-price">{{ promo_product.price | money }}</p>
                        </div>
                      </a>
                    {%- elsif promo_image != blank -%}
                      <div class="slideshow__promo-inner block">
                        <div class="slideshow__promo-img">
                          {{ promo_image | image_url: width: 600 | image_tag: class: 'img-fit', loading: 'lazy', widths: '300, 400, 600' }}
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                {%- elsif request.design_mode and i == 1 -%}
                  <div class="slideshow__promo-card slideshow__promo-card--placeholder">
                    <div class="slideshow__promo-img slideshow__promo-img--placeholder">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      {%- if section.settings.show_arrows -%}
        <button type="button" class="slideshow-edge-arrow slideshow-edge-arrow--prev no-js-hidden" name="prev" aria-controls="slideshow-{{ section.id }}" aria-label="{{ 'general.slider.previous' | t }}">
          <span aria-hidden="true">{% render 'icon-chevron-left' %}</span>
        </button>
        <button type="button" class="slideshow-edge-arrow slideshow-edge-arrow--next no-js-hidden" name="next" aria-controls="slideshow-{{ section.id }}" aria-label="{{ 'general.slider.next' | t }}">
          <span aria-hidden="true">{% render 'icon-chevron-right' %}</span>
        </button>
      {%- endif -%}

      <div class="slideshow-ctrl absolute flex{% if section.settings.nav_style == 'number_bar' %} slideshow-ctrl--number-bar{% else %} justify-center items-center{% endif %} w-full pointer-events-none no-js-hidden">
        {%- if section.settings.nav_style == 'slideshow_nav_dots' or section.settings.nav_style == 'slideshow_nav_lines' -%}
          <div class="slideshow-pagination flex items-center">
            {%- for block in section.blocks -%}
              <button class="page-btn pointer-events-initial" data-index="{{ forloop.index0 }}" aria-controls="slideshow-{{ section.id }}"{% if forloop.first %} aria-current="true"{% endif %}>
                <span class="visually-hidden">{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}</span>
                {%- if section.settings.nav_style == 'slideshow_nav_lines' -%}
                  <span class="page-btn__line block relative overflow-hidden pointer-events-none"></span>
                {%- else -%}
                  <svg width="30" height="30" viewBox="0 0 30 30" fill="none" class="page-btn__circle block pointer-events-none">
                    <circle class="page-btn__fg-circle" cx="15" cy="15" r="3.5" />
                    <circle class="page-btn__bg-circle" cx="15" cy="15" r="6" />
                  </svg>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>

        {%- elsif section.settings.nav_style == 'number_bar' -%}
          <div class="slideshow-number-nav pointer-events-initial">
            <span class="slideshow-number-nav__current slideshow-nav__counter-current" aria-live="polite">1</span>
            <span class="slideshow-number-nav__line" aria-hidden="true"></span>
            <span class="slideshow-number-nav__total" aria-hidden="true">{{ section.blocks.size }}</span>
          </div>
        {%- endif -%}

        {%- if autoplay and section.settings.nav_style == 'number_bar' -%}
          <div class="slideshow-nav slideshow-nav--progress pointer-events-initial">
            <button type="button" class="slideshow-nav__btn autoplay-btn slideshow-progress-btn" aria-label="{{ 'sections.slideshow.pause' | t }}">
              <svg class="slideshow-progress-svg" viewBox="0 0 36 36" width="36" height="36" aria-hidden="true">
                <circle class="slideshow-progress-bg" cx="18" cy="18" r="14" />
                <circle class="slideshow-progress-fg" cx="18" cy="18" r="14" />
              </svg>
              <span class="pause-icon block pointer-events-none" aria-hidden="true">{% render 'icon-pause' %}</span>
              <span class="play-icon block pointer-events-none" aria-hidden="true">{% render 'icon-video' %}</span>
            </button>
          </div>
        {%- elsif autoplay and section.settings.slider_pause -%}
          <div class="slideshow-nav flex items-center pointer-events-initial">
            <div class="slideshow-nav__autoplay flex items-center">
              <button type="button" class="slideshow-nav__btn autoplay-btn btn">
                <span class="pause-icon block pointer-events-none">
                  <span class="visually-hidden">{{ 'sections.slideshow.pause' | t }}</span>
                  {% render 'icon-pause' %}
                </span>
                <span class="play-icon block pointer-events-none">
                  <span class="visually-hidden">{{ 'sections.slideshow.play' | t }}</span>
                  {% render 'icon-video' %}
                </span>
              </button>
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </slide-show>
</div>

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "section",
  "class": "cc-slideshow",
  "settings": [
    {
      "type": "header",
      "content": "Slide"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Auto-play every",
      "default": 5,
      "info": "Leave 0 to disable auto-play"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "nav_style",
      "label": "Pagination",
      "options": [
        {
          "value": "number_bar",
          "label": "Number bar"
        },
        {
          "value": "slideshow_nav_dots",
          "label": "Dots"
        },
        {
          "value": "slideshow_nav_lines",
          "label": "Lines"
        }
      ],
      "default": "number_bar"
    },
    {
      "type": "color",
      "id": "pagination_color",
      "label": "Pagination color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Transition effect",
      "options": [
        {
          "value": "slide-fade",
          "label": "Slide"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "zoom-in",
          "label": "Zoom in"
        }
      ],
      "default": "slide-fade"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "fixed_height_desktop",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Desktop row height",
      "default": 450
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "contained",
          "label": "Contained"
        }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "fixed_height_mobile",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Mobile row height",
      "default": 400
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme (light)",
      "info": "When \"Transparent background\" is chosen, the text color can be set in each slide.",
      "options": [
        {
          "value": "white",
          "label": "Transparent background"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "Scheme 1"
        },
        {
          "value": "2",
          "label": "Scheme 2"
        },
        {
          "value": "3",
          "label": "Scheme 3"
        }
      ],
      "default": "white"
    },
    {
      "type": "select",
      "id": "color_scheme_dark",
      "label": "Color scheme (dark)",
      "options": [
        {
          "value": "white",
          "label": "Transparent background"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "Scheme 1"
        },
        {
          "value": "2",
          "label": "Scheme 2"
        },
        {
          "value": "3",
          "label": "Scheme 3"
        }
      ],
      "default": "white"
    },
    {
      "type": "color",
      "id": "tint_color",
      "label": "Image tint color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "tint_opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Image tint opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Accessibility / SEO"
    },
    {
      "type": "text",
      "id": "accessibility_info",
