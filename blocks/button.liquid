{%- if block.settings.button_label != blank -%}
  {%- liquid
    assign btn_class = 'btn btn--primary'
    if block.settings.button_style == 'secondary'
      assign btn_class = 'btn btn--secondary'
    elsif block.settings.button_style == 'link'
      assign btn_class = 'link'
    endif
    if block.settings.button_size == 'small'
      assign btn_class = btn_class | append: ' btn--small'
    elsif block.settings.button_size == 'large'
      assign btn_class = btn_class | append: ' btn--large'
    endif
  -%}
  {%- style -%}
    #block-{{ block.id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
      padding-left: {{ block.settings.padding_left }}px;
      padding-right: {{ block.settings.padding_right }}px;
    }
  {%- endstyle -%}
  <div id="block-{{ block.id }}" {{ block.shopify_attributes }}>
    <a class="{{ btn_class }}"
      {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %}
      {% if block.settings.button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
      {{- block.settings.button_label | escape -}}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open this link in a new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        { "value": "small",  "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large",  "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary",   "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "link",      "label": "Link" }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Left",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Right",
      "default": 0
    }
  ]
}
{% endschema %}
